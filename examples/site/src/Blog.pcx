<section pp-init="init">
  <h1>Blog</h1>
  <p class="sub">
    Fetched from <code>list_articles()</code> — a <code>#[server]</code> function
    that reads <code>articles.json</code> off the server's disk.
  </p>

  <p pp-show="loading" class="status"><em>Loading articles…</em></p>
  <p pp-show="error" class="status status--error"><span pp-text="error"></span></p>

  <div pp-html="list_html"></div>
</section>
