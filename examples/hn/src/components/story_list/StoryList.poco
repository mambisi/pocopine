<section pp-init="init">
  <form class="search" pp-on:submit.prevent="search">
    <input
      class="search__input"
      type="search"
      placeholder="search stories on hacker news…"
      pp-model="query"
      pp-on:input.debounce.300="search"
      autocomplete="off"
      spellcheck="false"
    />
    <button type="submit" class="search__submit">Search</button>
  </form>

  <div class="status-row">
    <p pp-show="loading" class="status"><em>Fetching…</em></p>
    <p pp-show="!loading && applied_query" class="status">
      <strong pp-text="count"></strong> results for <code pp-text="applied_query"></code> &middot; <strong pp-text="fetch_ms"></strong> ms
    </p>
    <p pp-show="!loading && !applied_query" class="status">
      <strong pp-text="count"></strong> stories on the front page &middot; fetched in <strong pp-text="fetch_ms"></strong> ms
    </p>
  </div>

  <p pp-show="error" class="status status--error"><span pp-text="error"></span></p>

  <ol class="stories">
    <template pp-for="story in stories">
      <li class="story">
        <div class="story__body">
          <a
            pp-show="story.external"
            class="story__title"
            pp-bind:href="story.title_href"
            target="_blank"
            rel="noopener noreferrer"
            pp-text="story.title"
          ></a>
          <a
            pp-show="!story.external"
            class="story__title"
            pp-bind:href="story.title_href"
            pp-route
            pp-text="story.title"
          ></a>
          <span pp-show="story.domain" class="domain">(<span pp-text="story.domain"></span>)</span>
          <div class="story__meta">
            <span class="points"><strong pp-text="story.points"></strong> points</span>
            <span class="sep">·</span>
            <span class="author">by <span pp-text="story.author"></span></span>
            <span class="sep">·</span>
            <span class="age" pp-text="story.age"></span>
            <span class="sep">·</span>
            <a class="comments-link" pp-bind:href="story.item_url" pp-route pp-text="story.comments_label"></a>
          </div>
        </div>
      </li>
    </template>
  </ol>
</section>
