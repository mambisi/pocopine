<div>
  <h1>Pine</h1>
  <p class="lead">Unstyled, accessible UI primitives for pocopine.</p>

  <!-- Label + Separator + Progress + AspectRatio + Toolbar — -->
  <!-- small primitives showcased together.                 -->
  <h2>Label, Separator, Progress</h2>
  <section>
    <div class="row" style="align-items:center;margin-bottom:0.75rem">
      <pine-label target="demo-name">Name</pine-label>
      <input id="demo-name" type="text" placeholder="clicking the label focuses me">
    </div>
    <pine-separator></pine-separator>
    <div style="margin:0.75rem 0">
      <pine-progress-root value="42" max="100">
        <pine-progress-indicator></pine-progress-indicator>
      </pine-progress-root>
    </div>
    <pine-separator></pine-separator>
    <div style="margin-top:0.75rem">
      <pine-progress-root value="-1">
        <pine-progress-indicator></pine-progress-indicator>
      </pine-progress-root>
      <span style="font-size:0.875rem;color:var(--fg-muted);margin-left:0.5rem">
        indeterminate
      </span>
    </div>
  </section>

  <h2>Aspect ratio</h2>
  <section class="row">
    <div style="width:280px">
      <pine-aspect-ratio ratio="1.777">
        <div class="ar-demo">16 : 9</div>
      </pine-aspect-ratio>
    </div>
    <div style="width:180px">
      <pine-aspect-ratio ratio="1">
        <div class="ar-demo">1 : 1</div>
      </pine-aspect-ratio>
    </div>
  </section>

  <h2>Toolbar</h2>
  <section>
    <pine-toolbar-root>
      <pine-toolbar-button @click="action_bump">Save</pine-toolbar-button>
      <pine-toolbar-button @click="action_bump">Undo</pine-toolbar-button>
      <pine-toolbar-separator></pine-toolbar-separator>
      <pine-toggle-group-root type="multiple">
        <pine-toggle-group-item value="bold"><strong>B</strong></pine-toggle-group-item>
        <pine-toggle-group-item value="italic"><em>I</em></pine-toggle-group-item>
        <pine-toggle-group-item value="underline"><u>U</u></pine-toggle-group-item>
      </pine-toggle-group-root>
      <pine-toolbar-separator></pine-toolbar-separator>
      <pine-toolbar-link href="#">Docs</pine-toolbar-link>
    </pine-toolbar-root>
  </section>

  <!-- PineButton ─────────────────────────────────────────── -->
  <h2>Button</h2>
  <section class="row">
    <pine-button variant="primary" @click="bump">
      <span>Primary · </span><span pp-text="clicks"></span>
    </pine-button>
    <pine-button variant="destructive">Destructive</pine-button>
    <pine-button variant="ghost">Ghost</pine-button>
    <pine-button disabled="true">Disabled</pine-button>
    <pine-button pp-as variant="ghost">
      <a href="https://github.com/mambisi/pocopine">Repo ↗</a>
    </pine-button>
  </section>

  <!-- PineDialog — compound (Radix-style) ────────────────── -->
  <h2>Dialog</h2>
  <section class="row">
    <pine-dialog-root pp-model:open="dialog_open">
      <pine-dialog-trigger pp-as>
        <pine-button variant="destructive">Delete file</pine-button>
      </pine-dialog-trigger>
      <pine-dialog-portal>
        <pine-dialog-overlay></pine-dialog-overlay>
        <pine-dialog-content>
          <pine-dialog-title>Delete file?</pine-dialog-title>
          <pine-dialog-description>This action cannot be undone.</pine-dialog-description>
          <div class="row" style="margin-top:1rem;justify-content:flex-end">
            <pine-dialog-close pp-as>
              <pine-button variant="ghost">Cancel</pine-button>
            </pine-dialog-close>
            <pine-dialog-close pp-as>
              <pine-button variant="destructive">Delete</pine-button>
            </pine-dialog-close>
          </div>
        </pine-dialog-content>
      </pine-dialog-portal>
    </pine-dialog-root>
  </section>

  <!-- PineAlertDialog — interruptive confirmation ────────── -->
  <h2>Alert dialog</h2>
  <section class="row">
    <pine-alert-dialog-root pp-model:open="alert_dialog_open">
      <pine-alert-dialog-trigger pp-as>
        <pine-button variant="destructive">Destroy project</pine-button>
      </pine-alert-dialog-trigger>
      <pine-alert-dialog-portal>
        <pine-alert-dialog-overlay></pine-alert-dialog-overlay>
        <pine-alert-dialog-content>
          <pine-alert-dialog-title>Destroy project?</pine-alert-dialog-title>
          <pine-alert-dialog-description>
            All files will be permanently removed. This cannot be undone.
          </pine-alert-dialog-description>
          <div class="row" style="margin-top:1rem;justify-content:flex-end">
            <pine-alert-dialog-cancel pp-as>
              <pine-button variant="ghost">Keep project</pine-button>
            </pine-alert-dialog-cancel>
            <pine-alert-dialog-action pp-as @click="confirm_destroy">
              <pine-button variant="destructive">Destroy</pine-button>
            </pine-alert-dialog-action>
          </div>
        </pine-alert-dialog-content>
      </pine-alert-dialog-portal>
    </pine-alert-dialog-root>
  </section>

  <!-- PinePopover — compound (Radix-style) ───────────────── -->
  <h2>Popover</h2>
  <section class="row">
    <pine-popover-root pp-model:open="popover_open">
      <pine-popover-trigger>
        <span pp-text="popover_open ? 'Close popover' : 'Open popover'"></span>
      </pine-popover-trigger>
      <pine-popover-portal>
        <pine-popover-content>
          <p style="margin:0">Anchored to the trigger.</p>
          <p style="margin:0.5rem 0 0;font-size:0.8125rem;color:var(--fg-muted)">
            Click outside or press Escape to close.
          </p>
        </pine-popover-content>
      </pine-popover-portal>
    </pine-popover-root>
  </section>

  <!-- PineDropdownMenu — compound (Radix-style) ──────────── -->
  <h2>Dropdown menu</h2>
  <section class="row">
    <pine-dropdown-menu-root>
      <pine-dropdown-menu-trigger>Actions ▾</pine-dropdown-menu-trigger>
      <pine-dropdown-menu-portal>
        <pine-dropdown-menu-content>
          <pine-dropdown-menu-group>
            <pine-dropdown-menu-label>Counters</pine-dropdown-menu-label>
            <pine-dropdown-menu-item @click="action_bump">Increment click count</pine-dropdown-menu-item>
            <pine-dropdown-menu-item @click="action_toggle_dark">Toggle dark mode</pine-dropdown-menu-item>
          </pine-dropdown-menu-group>
          <pine-dropdown-menu-separator></pine-dropdown-menu-separator>
          <pine-dropdown-menu-group>
            <pine-dropdown-menu-label>Danger zone</pine-dropdown-menu-label>
            <pine-dropdown-menu-item disabled>Export (disabled)</pine-dropdown-menu-item>
            <pine-dropdown-menu-item @click="action_reset">Reset demo</pine-dropdown-menu-item>
          </pine-dropdown-menu-group>
        </pine-dropdown-menu-content>
      </pine-dropdown-menu-portal>
    </pine-dropdown-menu-root>

    <!-- Second instance — showcases checkbox-items, radio-group,
         and ItemIndicator sharing one compound surface. -->
    <pine-dropdown-menu-root>
      <pine-dropdown-menu-trigger>View ▾</pine-dropdown-menu-trigger>
      <pine-dropdown-menu-portal>
        <pine-dropdown-menu-content>
          <pine-dropdown-menu-label>Show</pine-dropdown-menu-label>
          <pine-dropdown-menu-checkbox-item pp-model:state="show_muted">
            <pine-dropdown-menu-item-indicator>✓</pine-dropdown-menu-item-indicator>
            Muted items
          </pine-dropdown-menu-checkbox-item>
          <pine-dropdown-menu-checkbox-item pp-model:state="show_archived">
            <pine-dropdown-menu-item-indicator>✓</pine-dropdown-menu-item-indicator>
            Archived
          </pine-dropdown-menu-checkbox-item>
          <pine-dropdown-menu-separator></pine-dropdown-menu-separator>
          <pine-dropdown-menu-label>Density</pine-dropdown-menu-label>
          <pine-dropdown-menu-radio-group pp-model:value="density">
            <pine-dropdown-menu-radio-item value="compact">
              <pine-dropdown-menu-item-indicator>●</pine-dropdown-menu-item-indicator>
              Compact
            </pine-dropdown-menu-radio-item>
            <pine-dropdown-menu-radio-item value="comfortable">
              <pine-dropdown-menu-item-indicator>●</pine-dropdown-menu-item-indicator>
              Comfortable
            </pine-dropdown-menu-radio-item>
            <pine-dropdown-menu-radio-item value="spacious">
              <pine-dropdown-menu-item-indicator>●</pine-dropdown-menu-item-indicator>
              Spacious
            </pine-dropdown-menu-radio-item>
          </pine-dropdown-menu-radio-group>
        </pine-dropdown-menu-content>
      </pine-dropdown-menu-portal>
    </pine-dropdown-menu-root>

    <!-- Third instance — Arrow + Sub + Content config props
         (side="top") all on one menu. -->
    <pine-dropdown-menu-root>
      <pine-dropdown-menu-trigger>File ▾</pine-dropdown-menu-trigger>
      <pine-dropdown-menu-portal>
        <pine-dropdown-menu-content side="top" align="start" side_offset="8">
          <pine-dropdown-menu-arrow></pine-dropdown-menu-arrow>
          <pine-dropdown-menu-item @click="action_bump">New file</pine-dropdown-menu-item>
          <pine-dropdown-menu-item @click="action_bump">Open…</pine-dropdown-menu-item>
          <pine-dropdown-menu-separator></pine-dropdown-menu-separator>
          <pine-dropdown-menu-sub>
            <pine-dropdown-menu-sub-trigger>Share to ▸</pine-dropdown-menu-sub-trigger>
            <pine-dropdown-menu-sub-content>
              <pine-dropdown-menu-item @click="action_bump">Email…</pine-dropdown-menu-item>
              <pine-dropdown-menu-item @click="action_bump">Slack…</pine-dropdown-menu-item>
              <pine-dropdown-menu-item @click="action_bump">Copy link</pine-dropdown-menu-item>
            </pine-dropdown-menu-sub-content>
          </pine-dropdown-menu-sub>
          <pine-dropdown-menu-separator></pine-dropdown-menu-separator>
          <pine-dropdown-menu-item @click="action_reset">Quit</pine-dropdown-menu-item>
        </pine-dropdown-menu-content>
      </pine-dropdown-menu-portal>
    </pine-dropdown-menu-root>

    <span style="font-size:0.875rem;color:var(--fg-muted)">
      actions fired: <strong>{actions_fired}</strong>
    </span>
  </section>

  <!-- PineContextMenu — right-click menu ──────────────────── -->
  <h2>Context menu</h2>
  <section>
    <pine-context-menu-root>
      <pine-context-menu-trigger>
        <div class="cm-canvas">
          Right-click (or long-press) anywhere inside this box.
        </div>
      </pine-context-menu-trigger>
      <pine-context-menu-portal>
        <pine-context-menu-content>
          <pine-context-menu-item @click="action_bump">Copy</pine-context-menu-item>
          <pine-context-menu-item @click="action_bump">Paste</pine-context-menu-item>
          <pine-context-menu-separator></pine-context-menu-separator>
          <pine-context-menu-item @click="action_reset">Reset demo</pine-context-menu-item>
        </pine-context-menu-content>
      </pine-context-menu-portal>
    </pine-context-menu-root>
  </section>

  <!-- PineAvatar — image with fallback ─────────────────── -->
  <h2>Avatar</h2>
  <section class="row">
    <pine-avatar-root>
      <pine-avatar-image src="https://i.pravatar.cc/80?u=pine-a" alt="A"></pine-avatar-image>
      <pine-avatar-fallback>AB</pine-avatar-fallback>
    </pine-avatar-root>
    <pine-avatar-root>
      <pine-avatar-image src="https://example.invalid/broken.jpg" alt="broken"></pine-avatar-image>
      <pine-avatar-fallback>??</pine-avatar-fallback>
    </pine-avatar-root>
    <span style="font-size:0.875rem;color:var(--fg-muted)">
      First loads via pravatar; second's URL is broken so its
      fallback stays visible.
    </span>
  </section>

  <!-- PineCollapsible — single-region open/close ─────────── -->
  <h2>Collapsible</h2>
  <section>
    <pine-collapsible-root pp-model:open="faq_open">
      <pine-collapsible-trigger>
        <span pp-text="faq_open ? 'Hide details' : 'Show details'"></span>
      </pine-collapsible-trigger>
      <pine-collapsible-content>
        <p style="margin:0">
          Body content revealed by the Collapsible compound.
          The Root owns `open`; Trigger and Content both inject
          the handle and mirror the state via `watch_scope_field`.
          <strong>Currently {faq_open ? 'open' : 'closed'}.</strong>
        </p>
      </pine-collapsible-content>
    </pine-collapsible-root>
  </section>

  <!-- PineAccordion — single-open exclusive sections ────── -->
  <h2>Accordion</h2>
  <section>
    <pine-accordion-root type="single" collapsible="true" pp-model:value="faq_item">
      <pine-accordion-item value="what">
        <pine-accordion-trigger>What is Pine?</pine-accordion-trigger>
        <pine-accordion-content>
          Pine is an unstyled, accessible primitive library on
          pocopine — ships behaviour, keyboard, ARIA. Zero CSS.
        </pine-accordion-content>
      </pine-accordion-item>
      <pine-accordion-item value="how">
        <pine-accordion-trigger>How do compound components work?</pine-accordion-trigger>
        <pine-accordion-content>
          Root owns state and provides its Handle via RFC-027
          `provide`/`inject`; descendants mirror fields via
          `watch_scope_field`.
        </pine-accordion-content>
      </pine-accordion-item>
      <pine-accordion-item value="ship">
        <pine-accordion-trigger>What's shipped?</pine-accordion-trigger>
        <pine-accordion-content>
          Button, Dialog, Popover, DropdownMenu (13 parts),
          Collapsible, Accordion, Tabs, Tooltip, Switch, Checkbox.
        </pine-accordion-content>
      </pine-accordion-item>
    </pine-accordion-root>
  </section>

  <!-- PineTabs — compound (Radix-style) ──────────────────── -->
  <h2>Tabs</h2>
  <section>
    <pine-tabs-root pp-model:value="tab">
      <pine-tabs-list>
        <pine-tabs-trigger value="account">Account</pine-tabs-trigger>
        <pine-tabs-trigger value="notifications">Notifications</pine-tabs-trigger>
        <pine-tabs-trigger value="billing">Billing</pine-tabs-trigger>
      </pine-tabs-list>
      <pine-tabs-content value="account">
        <strong>Account</strong> — manage your profile and auth.
      </pine-tabs-content>
      <pine-tabs-content value="notifications">
        <strong>Notifications</strong> — email and push preferences.
      </pine-tabs-content>
      <pine-tabs-content value="billing">
        <strong>Billing</strong> — invoices and payment methods.
      </pine-tabs-content>
    </pine-tabs-root>
  </section>

  <!-- PineHoverCard — hover-opened floating card ────────── -->
  <h2>Hover card</h2>
  <p style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
    Hover (or focus) any <code>@name</code> to see the user's card.
  </p>
  <section class="row" style="flex-wrap:wrap;gap:1rem">
    <span>
      Mentioned by
      <pine-hover-card-root open_delay="200" close_delay="200">
        <pine-hover-card-trigger>
          <a href="#ada" class="hc-link">@ada</a>
        </pine-hover-card-trigger>
        <pine-hover-card-portal>
          <pine-hover-card-content>
            <div style="display:flex;gap:0.75rem;align-items:center">
              <pine-avatar-root>
                <pine-avatar-image src="https://i.pravatar.cc/48?u=ada" alt="Ada"></pine-avatar-image>
                <pine-avatar-fallback>AL</pine-avatar-fallback>
              </pine-avatar-root>
              <div>
                <strong style="display:block">Ada Lovelace</strong>
                <span style="color:var(--fg-muted);font-size:0.875rem">
                  Mathematician · @ada
                </span>
              </div>
            </div>
            <p style="margin:0.75rem 0 0;font-size:0.875rem;color:var(--fg-muted)">
              Counted as the first programmer.
            </p>
          </pine-hover-card-content>
        </pine-hover-card-portal>
      </pine-hover-card-root>
      and
      <pine-hover-card-root open_delay="200" close_delay="200">
        <pine-hover-card-trigger>
          <a href="#grace" class="hc-link">@grace</a>
        </pine-hover-card-trigger>
        <pine-hover-card-portal>
          <pine-hover-card-content>
            <div style="display:flex;gap:0.75rem;align-items:center">
              <pine-avatar-root>
                <pine-avatar-image src="https://i.pravatar.cc/48?u=grace" alt="Grace"></pine-avatar-image>
                <pine-avatar-fallback>GH</pine-avatar-fallback>
              </pine-avatar-root>
              <div>
                <strong style="display:block">Grace Hopper</strong>
                <span style="color:var(--fg-muted);font-size:0.875rem">
                  Rear Admiral · @grace
                </span>
              </div>
            </div>
            <p style="margin:0.75rem 0 0;font-size:0.875rem;color:var(--fg-muted)">
              Coined "debugging". Built COBOL's parent compiler.
            </p>
          </pine-hover-card-content>
        </pine-hover-card-portal>
      </pine-hover-card-root>
      on the thread.
    </span>
    <span>
      Reviewed by
      <pine-hover-card-root open_delay="200" close_delay="200">
        <pine-hover-card-trigger>
          <a href="#alan" class="hc-link">@alan</a>
        </pine-hover-card-trigger>
        <pine-hover-card-portal>
          <pine-hover-card-content>
            <div style="display:flex;gap:0.75rem;align-items:center">
              <pine-avatar-root>
                <pine-avatar-image src="https://i.pravatar.cc/48?u=alan" alt="Alan"></pine-avatar-image>
                <pine-avatar-fallback>AT</pine-avatar-fallback>
              </pine-avatar-root>
              <div>
                <strong style="display:block">Alan Turing</strong>
                <span style="color:var(--fg-muted);font-size:0.875rem">
                  Logician · @alan
                </span>
              </div>
            </div>
            <p style="margin:0.75rem 0 0;font-size:0.875rem;color:var(--fg-muted)">
              Proved what machines can compute.
            </p>
          </pine-hover-card-content>
        </pine-hover-card-portal>
      </pine-hover-card-root>.
    </span>
    <span>
      Approved by
      <pine-hover-card-root open_delay="200" close_delay="200">
        <pine-hover-card-trigger>
          <a href="#linus" class="hc-link">@linus</a>
        </pine-hover-card-trigger>
        <pine-hover-card-portal>
          <pine-hover-card-content>
            <div style="display:flex;gap:0.75rem;align-items:center">
              <pine-avatar-root>
                <pine-avatar-image src="https://i.pravatar.cc/48?u=linus" alt="Linus"></pine-avatar-image>
                <pine-avatar-fallback>LT</pine-avatar-fallback>
              </pine-avatar-root>
              <div>
                <strong style="display:block">Linus Torvalds</strong>
                <span style="color:var(--fg-muted);font-size:0.875rem">
                  Kernel dev · @linus
                </span>
              </div>
            </div>
            <p style="margin:0.75rem 0 0;font-size:0.875rem;color:var(--fg-muted)">
              Wrote Linux. Wrote git.
            </p>
          </pine-hover-card-content>
        </pine-hover-card-portal>
      </pine-hover-card-root>.
    </span>
  </section>

  <!-- PineTooltip — compound (Radix-style) ───────────────── -->
  <h2>Tooltip</h2>
  <section class="row">
    <pine-tooltip-provider delay_duration="250">
      <pine-tooltip-root>
        <pine-tooltip-trigger>
          <pine-button variant="primary">Save</pine-button>
        </pine-tooltip-trigger>
        <pine-tooltip-portal>
          <pine-tooltip-content>Saves your work.</pine-tooltip-content>
        </pine-tooltip-portal>
      </pine-tooltip-root>
      <pine-tooltip-root>
        <pine-tooltip-trigger>
          <pine-button variant="ghost">Undo</pine-button>
        </pine-tooltip-trigger>
        <pine-tooltip-portal>
          <pine-tooltip-content>Undoes the last action.</pine-tooltip-content>
        </pine-tooltip-portal>
      </pine-tooltip-root>
    </pine-tooltip-provider>
    <span style="font-size:0.875rem;color:var(--fg-muted)">
      Hover Save, then move to Undo — Save's tooltip closes (one
      open at a time via Provider).
    </span>
  </section>

  <!-- PineRadioGroup — standalone form primitive ────────── -->
  <h2>Radio group</h2>
  <section>
    <pine-radio-group-root pp-model:value="plan" name="plan">
      <pine-radio-group-item value="free">
        <pine-radio-group-indicator>●</pine-radio-group-indicator>
        Free
      </pine-radio-group-item>
      <pine-radio-group-item value="pro">
        <pine-radio-group-indicator>●</pine-radio-group-indicator>
        Pro
      </pine-radio-group-item>
      <pine-radio-group-item value="enterprise">
        <pine-radio-group-indicator>●</pine-radio-group-indicator>
        Enterprise
      </pine-radio-group-item>
    </pine-radio-group-root>
    <span style="font-size:0.875rem;color:var(--fg-muted);margin-left:0.75rem">
      Arrow keys rove, Space/Enter selects. Currently:
      <strong pp-text="plan"></strong>.
    </span>
  </section>

  <!-- PineToggle + PineToggleGroup ───────────────────────── -->
  <h2>Toggle</h2>
  <section>
    <div class="row" style="margin-bottom:0.75rem;align-items:center">
      <pine-toggle pp-model:pressed="bold">
        <strong>B</strong>
      </pine-toggle>
      <span>Bold is <strong pp-text="bold ? 'on' : 'off'"></strong></span>
    </div>

    <div class="row" style="margin-bottom:0.75rem;align-items:center">
      <pine-toggle-group-root pp-model:value="align">
        <pine-toggle-group-item value="left">Left</pine-toggle-group-item>
        <pine-toggle-group-item value="center">Center</pine-toggle-group-item>
        <pine-toggle-group-item value="right">Right</pine-toggle-group-item>
      </pine-toggle-group-root>
      <span>Align: <strong pp-text="align || '(none)'"></strong></span>
    </div>

    <div class="row" style="align-items:center">
      <pine-toggle-group-root type="multiple" pp-model:values="format">
        <pine-toggle-group-item value="bold"><strong>B</strong></pine-toggle-group-item>
        <pine-toggle-group-item value="italic"><em>I</em></pine-toggle-group-item>
        <pine-toggle-group-item value="underline"><u>U</u></pine-toggle-group-item>
      </pine-toggle-group-root>
      <span>Format: <strong pp-text="format"></strong></span>
    </div>
  </section>

  <!-- PineSwitch + PineCheckbox ──────────────────────────── -->
  <h2>Switch &amp; Checkbox</h2>
  <section>
    <div class="row" style="margin-bottom:0.75rem">
      <pine-switch pp-model:checked="dark_mode"></pine-switch>
      <span>Dark mode: <strong pp-text="dark_mode ? 'on' : 'off'"></strong></span>
    </div>
    <div class="row">
      <pine-checkbox pp-model:state="agree_state"></pine-checkbox>
      <span>I agree — state: <strong pp-text="agree_state"></strong></span>
    </div>
  </section>

  <!-- PineOtpField ───────────────────────────────────────── -->
  <h2>OTP field</h2>
  <section>
    <p style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
      Enter the 6-digit code we sent to your inbox. Auto-advance,
      Backspace walks back, paste spreads across slots.
    </p>
    <pine-otp-field length="6"
                    type="numeric"
                    pp-model:value="otp_code"
                    label="Verification code"></pine-otp-field>
    <p style="margin:0.75rem 0 0;font-size:0.875rem">
      Code so far: <strong pp-text="otp_code || '(empty)'"></strong>
    </p>
  </section>

  <!-- PineSelect ─────────────────────────────────────────── -->
  <h2>Select</h2>
  <section>
    <p style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
      Listbox-backed single-choice picker. Click the trigger,
      pick with arrow keys + Enter, or just click an option.
    </p>
    <pine-select-root pp-model:value="selected_city">
      <pine-select-trigger>
        <pine-select-value>Choose a city…</pine-select-value>
        <span aria-hidden="true" style="margin-left:0.5rem">▾</span>
      </pine-select-trigger>
      <pine-select-portal>
        <pine-select-content>
          <pine-select-item value="lagos">Lagos</pine-select-item>
          <pine-select-item value="accra">Accra</pine-select-item>
          <pine-select-item value="nairobi">Nairobi</pine-select-item>
          <pine-select-separator></pine-select-separator>
          <pine-select-item value="cairo">Cairo</pine-select-item>
          <pine-select-item value="johannesburg">Johannesburg</pine-select-item>
          <pine-select-item value="casablanca" disabled>Casablanca (unavailable)</pine-select-item>
        </pine-select-content>
      </pine-select-portal>
    </pine-select-root>
    <p style="margin:0.75rem 0 0;font-size:0.875rem">
      Selected: <strong pp-text="selected_city || '(none)'"></strong>
    </p>
  </section>

  <!-- PineCombobox ───────────────────────────────────────── -->
  <h2>Combobox</h2>
  <section>
    <p style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
      Editable filter-driven listbox. Type to narrow the options,
      arrow keys move the highlighted match while the caret stays
      in the input, Enter picks it.
    </p>
    <pine-combobox-root pp-model:value="selected_framework">
      <pine-combobox-input placeholder="Search frameworks…"></pine-combobox-input>
      <pine-combobox-portal>
        <pine-combobox-content>
          <pine-combobox-item value="react">React</pine-combobox-item>
          <pine-combobox-item value="vue">Vue</pine-combobox-item>
          <pine-combobox-item value="svelte">Svelte</pine-combobox-item>
          <pine-combobox-item value="angular">Angular</pine-combobox-item>
          <pine-combobox-item value="solid">Solid</pine-combobox-item>
          <pine-combobox-item value="qwik">Qwik</pine-combobox-item>
          <pine-combobox-item value="leptos">Leptos</pine-combobox-item>
          <pine-combobox-item value="pocopine">pocopine</pine-combobox-item>
          <pine-combobox-empty>No framework matches that query.</pine-combobox-empty>
        </pine-combobox-content>
      </pine-combobox-portal>
    </pine-combobox-root>
    <p style="margin:0.75rem 0 0;font-size:0.875rem">
      Picked: <strong pp-text="selected_framework || '(none)'"></strong>
    </p>
  </section>

  <!-- PineCommand ────────────────────────────────────────── -->
  <h2>Command palette</h2>
  <section>
    <p style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
      Press <kbd>Ctrl</kbd> + <kbd>K</kbd> (or <kbd>⌘</kbd> + <kbd>K</kbd>)
      to open. Type to filter, Enter to run.
    </p>
    <pine-command-root shortcut="Mod+k">
      <pine-command-portal>
        <pine-command-overlay></pine-command-overlay>
        <pine-command-content>
          <pine-command-input placeholder="Type a command…"></pine-command-input>
          <pine-command-list>
            <pine-command-item value="new" @pp:command:select="cmd_new_file">
              <span>New File</span>
              <span class="pine-command-shortcut">⌘N</span>
            </pine-command-item>
            <pine-command-item value="open" @pp:command:select="cmd_open_file">
              <span>Open File</span>
              <span class="pine-command-shortcut">⌘O</span>
            </pine-command-item>
            <pine-command-item value="save" @pp:command:select="cmd_save">
              <span>Save</span>
              <span class="pine-command-shortcut">⌘S</span>
            </pine-command-item>
            <pine-command-item value="theme" @pp:command:select="cmd_toggle_theme">
              <span>Toggle dark mode</span>
            </pine-command-item>
            <pine-command-item value="settings" @pp:command:select="cmd_settings">
              <span>Open Settings</span>
              <span class="pine-command-shortcut">⌘,</span>
            </pine-command-item>
            <pine-command-empty>No command matches that query.</pine-command-empty>
          </pine-command-list>
        </pine-command-content>
      </pine-command-portal>
    </pine-command-root>
    <p style="margin:0.75rem 0 0;font-size:0.875rem">
      Last command: <strong pp-text="last_command || '(none)'"></strong>
    </p>
  </section>

  <!-- PineSlider ─────────────────────────────────────────── -->
  <h2>Slider</h2>
  <section>
    <p style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
      Drag the thumb, click the track, or focus and use
      arrows / Home / End / PageUp / PageDown.
    </p>
    <pine-slider-root min="0"
                      max="100"
                      step="5"
                      pp-model:value="volume">
      <pine-slider-track>
        <pine-slider-range></pine-slider-range>
      </pine-slider-track>
      <pine-slider-thumb></pine-slider-thumb>
    </pine-slider-root>
    <p style="margin:0.75rem 0 0;font-size:0.875rem">
      Volume: <strong pp-text="volume"></strong>
    </p>
  </section>

  <!-- PineScrollArea ─────────────────────────────────────── -->
  <h2>Scroll area</h2>
  <section>
    <p style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
      Custom-scrollbar overlay. Pick a `type` to see how the
      scrollbars appear: <strong>always</strong> (persistent),
      <strong>auto</strong> (visible only on overflow),
      <strong>scroll</strong> (shown during scroll + fades),
      <strong>hover</strong> (shown on hover or scroll + fades).
    </p>
    <pine-radio-group-root pp-model:value="scroll_type" name="scroll_type" style="margin-bottom:1rem">
      <pine-radio-group-item value="auto">
        <pine-radio-group-indicator>●</pine-radio-group-indicator>
        auto
      </pine-radio-group-item>
      <pine-radio-group-item value="always">
        <pine-radio-group-indicator>●</pine-radio-group-indicator>
        always
      </pine-radio-group-item>
      <pine-radio-group-item value="scroll">
        <pine-radio-group-indicator>●</pine-radio-group-indicator>
        scroll
      </pine-radio-group-item>
      <pine-radio-group-item value="hover">
        <pine-radio-group-indicator>●</pine-radio-group-indicator>
        hover
      </pine-radio-group-item>
    </pine-radio-group-root>
    <div class="sa-demo-frame">
      <pine-scroll-area-root :type="scroll_type" scroll-hide-delay="500">
        <pine-scroll-area-viewport>
          <div class="sa-long">
            <h3 style="margin-top:0">Long content</h3>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit.
              Sed do eiusmod tempor incididunt ut labore et dolore
              magna aliqua. Ut enim ad minim veniam, quis nostrud
              exercitation ullamco laboris nisi ut aliquip ex ea
              commodo consequat.
            </p>
            <p>
              Duis aute irure dolor in reprehenderit in voluptate
              velit esse cillum dolore eu fugiat nulla pariatur.
              Excepteur sint occaecat cupidatat non proident, sunt
              in culpa qui officia deserunt mollit anim id est laborum.
            </p>
            <p>
              Sed ut perspiciatis unde omnis iste natus error sit
              voluptatem accusantium doloremque laudantium, totam rem
              aperiam, eaque ipsa quae ab illo inventore veritatis.
            </p>
            <p>
              At vero eos et accusamus et iusto odio dignissimos
              ducimus qui blanditiis praesentium voluptatum deleniti
              atque corrupti quos dolores et quas molestias excepturi.
            </p>
            <p style="white-space:nowrap">
              ▸ This line intentionally overflows horizontally so the
              horizontal scrollbar + corner show up when the axis
              actually has overflow. Keep scrolling right →→→ or
              resize the column and watch the scrollbar auto-hide.
            </p>
            <p>
              Nemo enim ipsam voluptatem quia voluptas sit aspernatur
              aut odit aut fugit, sed quia consequuntur magni dolores
              eos qui ratione voluptatem sequi nesciunt.
            </p>
          </div>
        </pine-scroll-area-viewport>
        <pine-scroll-area-scrollbar orientation="vertical">
          <pine-scroll-area-thumb></pine-scroll-area-thumb>
        </pine-scroll-area-scrollbar>
        <pine-scroll-area-scrollbar orientation="horizontal">
          <pine-scroll-area-thumb></pine-scroll-area-thumb>
        </pine-scroll-area-scrollbar>
        <pine-scroll-area-corner></pine-scroll-area-corner>
      </pine-scroll-area-root>
    </div>
  </section>

  <!-- PineSplitter ───────────────────────────────────────── -->
  <h2>Splitter</h2>
  <section>
    <p style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
      Resizable panels. Drag the handles, or focus a handle and
      use arrows / Home / End. Each commit emits the new
      <code>Vec&lt;f64&gt;</code> on the Group's <code>pp:update:model</code>.
    </p>
    <div class="splitter-frame">
      <pine-splitter-group direction="horizontal" pp-model:sizes="splitter_sizes">
        <pine-splitter-panel default-size="25" min-size="10">
          <div class="splitter-pane">Sidebar</div>
        </pine-splitter-panel>
        <pine-splitter-resize-handle></pine-splitter-resize-handle>
        <pine-splitter-panel default-size="50" min-size="20">
          <div class="splitter-pane">Main content</div>
        </pine-splitter-panel>
        <pine-splitter-resize-handle></pine-splitter-resize-handle>
        <pine-splitter-panel default-size="25" min-size="10">
          <div class="splitter-pane">Details</div>
        </pine-splitter-panel>
      </pine-splitter-group>
    </div>
    <p style="margin:0.75rem 0 0;font-size:0.875rem">
      Current sizes: <strong pp-text="splitter_sizes"></strong>
    </p>
  </section>

  <!-- PineTree ───────────────────────────────────────────── -->
  <h2>Tree</h2>
  <section>
    <p style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
      Click the chevron (▸) to expand / collapse, click the row to
      select. Focus the tree and use ↑ ↓ → ← / Enter / Home / End.
    </p>
    <pine-tree-root type="single" pp-model:value="tree_value" class="tree-demo">
      <pine-tree-item value="src">
        <pine-tree-item-toggle>▸</pine-tree-item-toggle>
        <span>src/</span>
        <pine-tree-item value="src/lib.rs">
          <span class="tree-leaf-spacer"></span>
          <span>lib.rs</span>
        </pine-tree-item>
        <pine-tree-item value="src/main.rs">
          <span class="tree-leaf-spacer"></span>
          <span>main.rs</span>
        </pine-tree-item>
        <pine-tree-item value="src/components">
          <pine-tree-item-toggle>▸</pine-tree-item-toggle>
          <span>components/</span>
          <pine-tree-item value="src/components/Button.rs">
            <span class="tree-leaf-spacer"></span>
            <span>Button.rs</span>
          </pine-tree-item>
          <pine-tree-item value="src/components/Menu.rs">
            <span class="tree-leaf-spacer"></span>
            <span>Menu.rs</span>
          </pine-tree-item>
        </pine-tree-item>
      </pine-tree-item>
      <pine-tree-item value="tests">
        <pine-tree-item-toggle>▸</pine-tree-item-toggle>
        <span>tests/</span>
        <pine-tree-item value="tests/smoke.rs">
          <span class="tree-leaf-spacer"></span>
          <span>smoke.rs</span>
        </pine-tree-item>
      </pine-tree-item>
      <pine-tree-item value="Cargo.toml">
        <span class="tree-leaf-spacer"></span>
        <span>Cargo.toml</span>
      </pine-tree-item>
      <pine-tree-item value="README.md">
        <span class="tree-leaf-spacer"></span>
        <span>README.md</span>
      </pine-tree-item>
    </pine-tree-root>
    <p style="margin:0.75rem 0 0;font-size:0.875rem">
      Selected: <strong pp-text="tree_value || '(none)'"></strong>
    </p>
  </section>
</div>
