<div>
  <h1>Pine</h1>
  <p class="lead">Unstyled, accessible UI primitives for pocopine.</p>

  <!-- Live selection state — every component's current value is
       visible here so interactions have obvious feedback. -->
  <section class="state-panel" aria-label="Live state">
    <dl>
      <dt>Button clicks</dt> <dd pp-text="clicks"></dd>
      <dt>Dialog</dt>        <dd pp-text="dialog_open ? 'open' : 'closed'"></dd>
      <dt>AlertDialog</dt>   <dd pp-text="alert_dialog_open ? 'open' : 'closed'"></dd>
      <dt>Last alert action</dt><dd pp-text="last_action"></dd>
      <dt>Popover</dt>       <dd pp-text="popover_open ? 'open' : 'closed'"></dd>
      <dt>Menu actions fired</dt><dd pp-text="actions_fired"></dd>
      <dt>Current tab</dt>   <dd pp-text="tab"></dd>
      <dt>Dark mode</dt>     <dd pp-text="dark_mode ? 'on' : 'off'"></dd>
      <dt>Agree</dt>         <dd pp-text="agree_state"></dd>
      <dt>Plan</dt>          <dd pp-text="plan"></dd>
      <dt>Bold</dt>          <dd pp-text="bold ? 'on' : 'off'"></dd>
      <dt>Align</dt>         <dd pp-text="align"></dd>
      <dt>Format flags</dt>  <dd pp-text="format"></dd>
    </dl>
  </section>

  <!-- PineButton ─────────────────────────────────────────── -->
  <h2>Button</h2>
  <section class="row">
    <pine-button variant="primary" @click="bump">
      <span>Primary · </span><span pp-text="clicks"></span>
    </pine-button>
    <pine-button variant="destructive">Destructive</pine-button>
    <pine-button variant="ghost">Ghost</pine-button>
    <pine-button disabled="true">Disabled</pine-button>
    <pine-button pp-as variant="ghost">
      <a href="https://github.com/mambisi/pocopine">Repo ↗</a>
    </pine-button>
  </section>

  <!-- PineDialog — compound (Radix-style) ────────────────── -->
  <h2>Dialog</h2>
  <section class="row">
    <pine-dialog-root pp-model:open="dialog_open">
      <pine-dialog-trigger pp-as>
        <pine-button variant="destructive">Delete file</pine-button>
      </pine-dialog-trigger>
      <pine-dialog-portal>
        <pine-dialog-overlay></pine-dialog-overlay>
        <pine-dialog-content>
          <pine-dialog-title>Delete file?</pine-dialog-title>
          <pine-dialog-description>This action cannot be undone.</pine-dialog-description>
          <div class="row" style="margin-top:1rem;justify-content:flex-end">
            <pine-dialog-close pp-as>
              <pine-button variant="ghost">Cancel</pine-button>
            </pine-dialog-close>
            <pine-dialog-close pp-as>
              <pine-button variant="destructive">Delete</pine-button>
            </pine-dialog-close>
          </div>
        </pine-dialog-content>
      </pine-dialog-portal>
    </pine-dialog-root>
  </section>

  <!-- PineAlertDialog — interruptive confirmation ────────── -->
  <h2>Alert dialog</h2>
  <section class="row">
    <pine-alert-dialog-root pp-model:open="alert_dialog_open">
      <pine-alert-dialog-trigger pp-as>
        <pine-button variant="destructive">Destroy project</pine-button>
      </pine-alert-dialog-trigger>
      <pine-alert-dialog-portal>
        <pine-alert-dialog-overlay></pine-alert-dialog-overlay>
        <pine-alert-dialog-content>
          <pine-alert-dialog-title>Destroy project?</pine-alert-dialog-title>
          <pine-alert-dialog-description>
            All files will be permanently removed. This cannot be undone.
          </pine-alert-dialog-description>
          <div class="row" style="margin-top:1rem;justify-content:flex-end">
            <pine-alert-dialog-cancel pp-as>
              <pine-button variant="ghost">Keep project</pine-button>
            </pine-alert-dialog-cancel>
            <pine-alert-dialog-action pp-as @click="confirm_destroy">
              <pine-button variant="destructive">Destroy</pine-button>
            </pine-alert-dialog-action>
          </div>
        </pine-alert-dialog-content>
      </pine-alert-dialog-portal>
    </pine-alert-dialog-root>
  </section>

  <!-- PinePopover — compound (Radix-style) ───────────────── -->
  <h2>Popover</h2>
  <section class="row">
    <pine-popover-root pp-model:open="popover_open">
      <pine-popover-trigger>
        <span pp-text="popover_open ? 'Close popover' : 'Open popover'"></span>
      </pine-popover-trigger>
      <pine-popover-portal>
        <pine-popover-content>
          <p style="margin:0">Anchored to the trigger.</p>
          <p style="margin:0.5rem 0 0;font-size:0.8125rem;color:var(--fg-muted)">
            Click outside or press Escape to close.
          </p>
        </pine-popover-content>
      </pine-popover-portal>
    </pine-popover-root>
  </section>

  <!-- PineDropdownMenu — compound (Radix-style) ──────────── -->
  <h2>Dropdown menu</h2>
  <section class="row">
    <pine-dropdown-menu-root>
      <pine-dropdown-menu-trigger>Actions ▾</pine-dropdown-menu-trigger>
      <pine-dropdown-menu-portal>
        <pine-dropdown-menu-content>
          <pine-dropdown-menu-group>
            <pine-dropdown-menu-label>Counters</pine-dropdown-menu-label>
            <pine-dropdown-menu-item @click="action_bump">Increment click count</pine-dropdown-menu-item>
            <pine-dropdown-menu-item @click="action_toggle_dark">Toggle dark mode</pine-dropdown-menu-item>
          </pine-dropdown-menu-group>
          <pine-dropdown-menu-separator></pine-dropdown-menu-separator>
          <pine-dropdown-menu-group>
            <pine-dropdown-menu-label>Danger zone</pine-dropdown-menu-label>
            <pine-dropdown-menu-item disabled>Export (disabled)</pine-dropdown-menu-item>
            <pine-dropdown-menu-item @click="action_reset">Reset demo</pine-dropdown-menu-item>
          </pine-dropdown-menu-group>
        </pine-dropdown-menu-content>
      </pine-dropdown-menu-portal>
    </pine-dropdown-menu-root>

    <!-- Second instance — showcases checkbox-items, radio-group,
         and ItemIndicator sharing one compound surface. -->
    <pine-dropdown-menu-root>
      <pine-dropdown-menu-trigger>View ▾</pine-dropdown-menu-trigger>
      <pine-dropdown-menu-portal>
        <pine-dropdown-menu-content>
          <pine-dropdown-menu-label>Show</pine-dropdown-menu-label>
          <pine-dropdown-menu-checkbox-item pp-model:state="show_muted">
            <pine-dropdown-menu-item-indicator>✓</pine-dropdown-menu-item-indicator>
            Muted items
          </pine-dropdown-menu-checkbox-item>
          <pine-dropdown-menu-checkbox-item pp-model:state="show_archived">
            <pine-dropdown-menu-item-indicator>✓</pine-dropdown-menu-item-indicator>
            Archived
          </pine-dropdown-menu-checkbox-item>
          <pine-dropdown-menu-separator></pine-dropdown-menu-separator>
          <pine-dropdown-menu-label>Density</pine-dropdown-menu-label>
          <pine-dropdown-menu-radio-group pp-model:value="density">
            <pine-dropdown-menu-radio-item value="compact">
              <pine-dropdown-menu-item-indicator>●</pine-dropdown-menu-item-indicator>
              Compact
            </pine-dropdown-menu-radio-item>
            <pine-dropdown-menu-radio-item value="comfortable">
              <pine-dropdown-menu-item-indicator>●</pine-dropdown-menu-item-indicator>
              Comfortable
            </pine-dropdown-menu-radio-item>
            <pine-dropdown-menu-radio-item value="spacious">
              <pine-dropdown-menu-item-indicator>●</pine-dropdown-menu-item-indicator>
              Spacious
            </pine-dropdown-menu-radio-item>
          </pine-dropdown-menu-radio-group>
        </pine-dropdown-menu-content>
      </pine-dropdown-menu-portal>
    </pine-dropdown-menu-root>

    <!-- Third instance — Arrow + Sub + Content config props
         (side="top") all on one menu. -->
    <pine-dropdown-menu-root>
      <pine-dropdown-menu-trigger>File ▾</pine-dropdown-menu-trigger>
      <pine-dropdown-menu-portal>
        <pine-dropdown-menu-content side="top" align="start" side_offset="8">
          <pine-dropdown-menu-arrow></pine-dropdown-menu-arrow>
          <pine-dropdown-menu-item @click="action_bump">New file</pine-dropdown-menu-item>
          <pine-dropdown-menu-item @click="action_bump">Open…</pine-dropdown-menu-item>
          <pine-dropdown-menu-separator></pine-dropdown-menu-separator>
          <pine-dropdown-menu-sub>
            <pine-dropdown-menu-sub-trigger>Share to ▸</pine-dropdown-menu-sub-trigger>
            <pine-dropdown-menu-sub-content>
              <pine-dropdown-menu-item @click="action_bump">Email…</pine-dropdown-menu-item>
              <pine-dropdown-menu-item @click="action_bump">Slack…</pine-dropdown-menu-item>
              <pine-dropdown-menu-item @click="action_bump">Copy link</pine-dropdown-menu-item>
            </pine-dropdown-menu-sub-content>
          </pine-dropdown-menu-sub>
          <pine-dropdown-menu-separator></pine-dropdown-menu-separator>
          <pine-dropdown-menu-item @click="action_reset">Quit</pine-dropdown-menu-item>
        </pine-dropdown-menu-content>
      </pine-dropdown-menu-portal>
    </pine-dropdown-menu-root>

    <span style="font-size:0.875rem;color:var(--fg-muted)">
      actions fired: <strong>{actions_fired}</strong>
    </span>
  </section>

  <!-- PineContextMenu — right-click menu ──────────────────── -->
  <h2>Context menu</h2>
  <section>
    <pine-context-menu-root>
      <pine-context-menu-trigger>
        <div class="cm-canvas">
          Right-click (or long-press) anywhere inside this box.
        </div>
      </pine-context-menu-trigger>
      <pine-context-menu-portal>
        <pine-context-menu-content>
          <pine-context-menu-item @click="action_bump">Copy</pine-context-menu-item>
          <pine-context-menu-item @click="action_bump">Paste</pine-context-menu-item>
          <pine-context-menu-separator></pine-context-menu-separator>
          <pine-context-menu-item @click="action_reset">Reset demo</pine-context-menu-item>
        </pine-context-menu-content>
      </pine-context-menu-portal>
    </pine-context-menu-root>
  </section>

  <!-- PineAvatar — image with fallback ─────────────────── -->
  <h2>Avatar</h2>
  <section class="row">
    <pine-avatar-root>
      <pine-avatar-image src="https://i.pravatar.cc/80?u=pine-a" alt="A"></pine-avatar-image>
      <pine-avatar-fallback>AB</pine-avatar-fallback>
    </pine-avatar-root>
    <pine-avatar-root>
      <pine-avatar-image src="https://example.invalid/broken.jpg" alt="broken"></pine-avatar-image>
      <pine-avatar-fallback>??</pine-avatar-fallback>
    </pine-avatar-root>
    <span style="font-size:0.875rem;color:var(--fg-muted)">
      First loads via pravatar; second's URL is broken so its
      fallback stays visible.
    </span>
  </section>

  <!-- PineCollapsible — single-region open/close ─────────── -->
  <h2>Collapsible</h2>
  <section>
    <pine-collapsible-root pp-model:open="faq_open">
      <pine-collapsible-trigger>
        <span pp-text="faq_open ? 'Hide details' : 'Show details'"></span>
      </pine-collapsible-trigger>
      <pine-collapsible-content>
        <p style="margin:0">
          Body content revealed by the Collapsible compound.
          The Root owns `open`; Trigger and Content both inject
          the handle and mirror the state via `watch_scope_field`.
          <strong>Currently {faq_open ? 'open' : 'closed'}.</strong>
        </p>
      </pine-collapsible-content>
    </pine-collapsible-root>
  </section>

  <!-- PineAccordion — single-open exclusive sections ────── -->
  <h2>Accordion</h2>
  <section>
    <pine-accordion-root type="single" collapsible="true" pp-model:value="faq_item">
      <pine-accordion-item value="what">
        <pine-accordion-trigger>What is Pine?</pine-accordion-trigger>
        <pine-accordion-content>
          Pine is an unstyled, accessible primitive library on
          pocopine — ships behaviour, keyboard, ARIA. Zero CSS.
        </pine-accordion-content>
      </pine-accordion-item>
      <pine-accordion-item value="how">
        <pine-accordion-trigger>How do compound components work?</pine-accordion-trigger>
        <pine-accordion-content>
          Root owns state and provides its Handle via RFC-027
          `provide`/`inject`; descendants mirror fields via
          `watch_scope_field`.
        </pine-accordion-content>
      </pine-accordion-item>
      <pine-accordion-item value="ship">
        <pine-accordion-trigger>What's shipped?</pine-accordion-trigger>
        <pine-accordion-content>
          Button, Dialog, Popover, DropdownMenu (13 parts),
          Collapsible, Accordion, Tabs, Tooltip, Switch, Checkbox.
        </pine-accordion-content>
      </pine-accordion-item>
    </pine-accordion-root>
  </section>

  <!-- PineTabs — compound (Radix-style) ──────────────────── -->
  <h2>Tabs</h2>
  <section>
    <pine-tabs-root pp-model:value="tab">
      <pine-tabs-list>
        <pine-tabs-trigger value="account">Account</pine-tabs-trigger>
        <pine-tabs-trigger value="notifications">Notifications</pine-tabs-trigger>
        <pine-tabs-trigger value="billing">Billing</pine-tabs-trigger>
      </pine-tabs-list>
      <pine-tabs-content value="account">
        <strong>Account</strong> — manage your profile and auth.
      </pine-tabs-content>
      <pine-tabs-content value="notifications">
        <strong>Notifications</strong> — email and push preferences.
      </pine-tabs-content>
      <pine-tabs-content value="billing">
        <strong>Billing</strong> — invoices and payment methods.
      </pine-tabs-content>
    </pine-tabs-root>
  </section>

  <!-- PineHoverCard — hover-opened floating card ────────── -->
  <h2>Hover card</h2>
  <section class="row">
    <pine-hover-card-root open_delay="200" close_delay="200">
      <pine-hover-card-trigger>
        <a href="#ada" class="hc-link">@ada</a>
      </pine-hover-card-trigger>
      <pine-hover-card-portal>
        <pine-hover-card-content>
          <div style="display:flex;gap:0.75rem;align-items:center">
            <pine-avatar-root>
              <pine-avatar-image src="https://i.pravatar.cc/48?u=ada" alt="Ada"></pine-avatar-image>
              <pine-avatar-fallback>AL</pine-avatar-fallback>
            </pine-avatar-root>
            <div>
              <strong style="display:block">Ada Lovelace</strong>
              <span style="color:var(--fg-muted);font-size:0.875rem">
                Mathematician · @ada
              </span>
            </div>
          </div>
          <p style="margin:0.75rem 0 0;font-size:0.875rem;color:var(--fg-muted)">
            Counted as the first programmer.
          </p>
        </pine-hover-card-content>
      </pine-hover-card-portal>
    </pine-hover-card-root>
    <span style="font-size:0.875rem;color:var(--fg-muted)">
      Hover or focus the link.
    </span>
  </section>

  <!-- PineTooltip — compound (Radix-style) ───────────────── -->
  <h2>Tooltip</h2>
  <section class="row">
    <pine-tooltip-root>
      <pine-tooltip-trigger>
        <pine-button variant="primary">Save</pine-button>
      </pine-tooltip-trigger>
      <pine-tooltip-portal>
        <pine-tooltip-content>Saves your work.</pine-tooltip-content>
      </pine-tooltip-portal>
    </pine-tooltip-root>
    <span style="font-size:0.875rem;color:var(--fg-muted)">
      Hover or focus the Save button.
    </span>
  </section>

  <!-- PineRadioGroup — standalone form primitive ────────── -->
  <h2>Radio group</h2>
  <section>
    <pine-radio-group-root pp-model:value="plan" name="plan">
      <pine-radio-group-item value="free">
        <pine-radio-group-indicator>●</pine-radio-group-indicator>
        Free
      </pine-radio-group-item>
      <pine-radio-group-item value="pro">
        <pine-radio-group-indicator>●</pine-radio-group-indicator>
        Pro
      </pine-radio-group-item>
      <pine-radio-group-item value="enterprise">
        <pine-radio-group-indicator>●</pine-radio-group-indicator>
        Enterprise
      </pine-radio-group-item>
    </pine-radio-group-root>
    <span style="font-size:0.875rem;color:var(--fg-muted);margin-left:0.75rem">
      Arrow keys rove, Space/Enter selects. Currently:
      <strong pp-text="plan"></strong>.
    </span>
  </section>

  <!-- PineToggle + PineToggleGroup ───────────────────────── -->
  <h2>Toggle</h2>
  <section>
    <div class="row" style="margin-bottom:0.75rem;align-items:center">
      <pine-toggle pp-model:pressed="bold">
        <strong>B</strong>
      </pine-toggle>
      <span>Bold is <strong pp-text="bold ? 'on' : 'off'"></strong></span>
    </div>

    <div class="row" style="margin-bottom:0.75rem;align-items:center">
      <pine-toggle-group-root pp-model:value="align">
        <pine-toggle-group-item value="left">Left</pine-toggle-group-item>
        <pine-toggle-group-item value="center">Center</pine-toggle-group-item>
        <pine-toggle-group-item value="right">Right</pine-toggle-group-item>
      </pine-toggle-group-root>
      <span>Align: <strong pp-text="align || '(none)'"></strong></span>
    </div>

    <div class="row" style="align-items:center">
      <pine-toggle-group-root type="multiple" pp-model:values="format">
        <pine-toggle-group-item value="bold"><strong>B</strong></pine-toggle-group-item>
        <pine-toggle-group-item value="italic"><em>I</em></pine-toggle-group-item>
        <pine-toggle-group-item value="underline"><u>U</u></pine-toggle-group-item>
      </pine-toggle-group-root>
      <span>Format: <strong pp-text="format"></strong></span>
    </div>
  </section>

  <!-- PineSwitch + PineCheckbox ──────────────────────────── -->
  <h2>Switch &amp; Checkbox</h2>
  <section>
    <div class="row" style="margin-bottom:0.75rem">
      <pine-switch pp-model:checked="dark_mode"></pine-switch>
      <span>Dark mode: <strong pp-text="dark_mode ? 'on' : 'off'"></strong></span>
    </div>
    <div class="row">
      <pine-checkbox pp-model:state="agree_state"></pine-checkbox>
      <span>I agree — state: <strong pp-text="agree_state"></strong></span>
    </div>
  </section>
</div>
