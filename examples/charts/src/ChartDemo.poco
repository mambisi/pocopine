<root class="chart-demo">
  <header class="chart-demo-header">
    <div>
      <h1>Pine Charts</h1>
      <p>SVG-first, unstyled chart primitives for Pocopine apps.</p>
    </div>
    <div class="chart-demo-actions" role="group" aria-label="Chart dataset">
      <button type="button"
              :aria-pressed="dataset == 'growth' ? 'true' : 'false'"
              :data-active="dataset == 'growth'"
              @click="show_growth">Growth</button>
      <button type="button"
              :aria-pressed="dataset == 'latency' ? 'true' : 'false'"
              :data-active="dataset == 'latency'"
              @click="show_latency">Latency</button>
    </div>
    <div class="chart-demo-actions" role="group" aria-label="Bar layout">
      <button type="button"
              :aria-pressed="bar_mode == 'grouped' ? 'true' : 'false'"
              :data-active="bar_mode == 'grouped'"
              @click="show_grouped">Grouped</button>
      <button type="button"
              :aria-pressed="bar_mode == 'stacked' ? 'true' : 'false'"
              :data-active="bar_mode == 'stacked'"
              @click="show_stacked">Stacked</button>
    </div>
    <div class="chart-demo-actions" role="group" aria-label="Share shape">
      <button type="button"
              :aria-pressed="pie_shape == 'pie' ? 'true' : 'false'"
              :data-active="pie_shape == 'pie'"
              @click="show_pie">Pie</button>
      <button type="button"
              :aria-pressed="pie_shape == 'donut' ? 'true' : 'false'"
              :data-active="pie_shape == 'donut'"
              @click="show_donut">Donut</button>
      <button type="button"
              :aria-pressed="pie_shape == 'half-donut' ? 'true' : 'false'"
              :data-active="pie_shape == 'half-donut'"
              @click="show_half_donut">Half donut</button>
    </div>
  </header>

  <pine-line-chart label="Weekly metric"
                   pp-bind:series="line_series"
                   x_label="Week"
                   y_label="Metric"
                   show_markers="true"
                   width="720"
                   height="360"></pine-line-chart>

  <pine-chart-legend label="Weekly metric legend"
                     pp-bind:items="line_legend"></pine-chart-legend>

  <pine-scatter-chart label="Cohort spread"
                      pp-bind:series="scatter_series"
                      x_label="Size"
                      y_label="Rate"
                      point_radius="4.5"
                      width="720"
                      height="320"></pine-scatter-chart>

  <pine-chart-legend label="Cohort spread legend"
                     pp-bind:items="scatter_legend"></pine-chart-legend>

  <pine-area-chart label="Trend area"
                   pp-bind:series="area_series"
                   x_label="Week"
                   y_label="Volume"
                   show_markers="true"
                   width="720"
                   height="320"></pine-area-chart>

  <pine-chart-legend label="Trend area legend"
                     pp-bind:items="area_legend"></pine-chart-legend>

  <pine-bar-chart label="Distribution"
                  pp-bind:series="bar_series"
                  pp-bind:mode="bar_mode"
                  x_label="Bucket"
                  y_label="Count"
                  width="720"
                  height="320"></pine-bar-chart>

  <pine-chart-legend label="Distribution legend"
                     pp-bind:items="bar_legend"></pine-chart-legend>

  <pine-pie-chart label="Channel share"
                  pp-bind:data="pie_data"
                  pp-bind:inner_radius="pie_inner_radius"
                  pp-bind:start_angle="pie_start_angle"
                  pp-bind:end_angle="pie_end_angle"
                  width="720"
                  height="320"></pine-pie-chart>

  <pine-chart-legend label="Channel share legend"
                     interactive="true"
                     pp-bind:items="pie_legend"></pine-chart-legend>
</root>
