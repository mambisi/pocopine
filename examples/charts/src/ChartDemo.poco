<root class="chart-demo">
  <header class="chart-demo-header">
    <div class="chart-demo-title">
      <h1>Pine Charts</h1>
      <p>SVG-first, unstyled chart primitives for Pocopine apps.</p>
    </div>
  </header>

  <section class="chart-demo-grid" aria-label="Chart examples">
    <article class="chart-card chart-card--hero">
      <header class="chart-card-header">
        <h2>Weekly metric</h2>
        <div class="chart-card-actions" role="group" aria-label="Weekly metric dataset">
          <button type="button"
                  :aria-pressed="combo_dataset == 'growth' ? 'true' : 'false'"
                  :data-active="combo_dataset == 'growth'"
                  @click="show_combo_growth">Growth</button>
          <button type="button"
                  :aria-pressed="combo_dataset == 'latency' ? 'true' : 'false'"
                  :data-active="combo_dataset == 'latency'"
                  @click="show_combo_latency">Latency</button>
        </div>
      </header>
      <pine-chart-responsive class="chart-panel" aspect_ratio="3.2" min_height="190">
    <pine-cartesian-chart label="Weekly metric combo"
                          animate="true"
                          animation_duration="180"
                          animation_easing="ease-out">
      <pine-chart-grid></pine-chart-grid>
      <pine-x-axis label="Week"></pine-x-axis>
      <pine-y-axis label="Metric"></pine-y-axis>
      <pine-bar-series key="actual"
                       pp-bind:label="combo_bar_label"
                       pp-bind:color="combo_bar_color"
                       pp-bind:data="combo_bar_data"></pine-bar-series>
      <pine-cartesian-reference-line key="goal"
                                     label="Goal"
                                     pp-bind:y="combo_goal"
                                     color="#667085"
                                     stroke_width="1.5"
                                     stroke_dasharray="4 4"></pine-cartesian-reference-line>
      <pine-area-series key="band"
                        label="Trend band"
                        fill="#1d6fd833"
                        color="#1d6fd8"
                        stroke_width="2"
                        pp-bind:points="combo_area_points"></pine-area-series>
      <pine-line-series key="target"
                        pp-bind:label="combo_line_label"
                        pp-bind:color="combo_line_color"
                        stroke_width="3"
                        show_markers="true"
                        marker_radius="3"
                        pp-bind:data="combo_line_data"></pine-line-series>
      <pine-scatter-series key="samples"
                           label="Samples"
                           color="#5b6ee1"
                           point_radius="4"
                           pp-bind:points="combo_scatter_points"></pine-scatter-series>
      <pine-cartesian-reference-dot key="latest"
                                    label="Latest"
                                    pp-bind:x="combo_latest_x"
                                    pp-bind:y="combo_latest_y"
                                    radius="7"
                                    fill="#18212f"
                                    stroke="#ffffff"
                                    stroke_width="2"></pine-cartesian-reference-dot>
      <pine-cartesian-reference-label key="latest-label"
                                      text="Latest"
                                      pp-bind:x="combo_latest_x"
                                      pp-bind:y="combo_latest_y"
                                      dy="-12"
                                      fill="#18212f"
                                      font_weight="700"></pine-cartesian-reference-label>
    </pine-cartesian-chart>
      </pine-chart-responsive>

      <pine-chart-legend class="chart-card-legend"
                         label="Weekly metric legend"
                         pp-bind:items="line_legend"></pine-chart-legend>
    </article>

    <article class="chart-card chart-card--metro">
      <header class="chart-card-header">
        <h2>Metro layer order</h2>
      </header>
      <pine-chart-responsive class="chart-panel chart-panel--metro"
                             aspect_ratio="3.2"
                             min_height="260">
        <pine-layer-chart label="Metro layer order"
                          animate="true"
                          animation_duration="180"
                          animation_easing="ease-out">
      <pine-chart-layer name="grid">
        <pine-chart-guide key="top-row" x1="80" y1="120" x2="820" y2="120"></pine-chart-guide>
        <pine-chart-guide key="mid-row" x1="80" y1="240" x2="820" y2="240"></pine-chart-guide>
        <pine-chart-guide key="bottom-row" x1="80" y1="360" x2="820" y2="360"></pine-chart-guide>
        <pine-chart-guide key="left-column" x1="160" y1="70" x2="160" y2="400"></pine-chart-guide>
        <pine-chart-guide key="center-column" x1="450" y1="70" x2="450" y2="400"></pine-chart-guide>
        <pine-chart-guide key="right-column" x1="720" y1="70" x2="720" y2="400"></pine-chart-guide>
      </pine-chart-layer>
      <pine-chart-layer name="reference-background">
        <pine-chart-reference-dot key="central-bg" label="Central" x="420" y="180" radius="18" fill="#19a974"></pine-chart-reference-dot>
        <pine-chart-reference-dot key="republic-bg" label="Republic" x="520" y="180" radius="18" fill="#f2c230"></pine-chart-reference-dot>
      </pine-chart-layer>
      <pine-chart-layer name="series">
        <pine-chart-line key="line-a" label="Line A" color="#19a974" stroke_width="14" pp-bind:points="metro_line_a"></pine-chart-line>
        <pine-chart-line key="line-b" label="Line B" color="#f2c230" stroke_width="14" pp-bind:points="metro_line_b"></pine-chart-line>
        <pine-chart-line key="line-c" label="Line C" color="#d9363e" stroke_width="14" pp-bind:points="metro_line_c"></pine-chart-line>
      </pine-chart-layer>
      <pine-chart-layer name="markers">
        <pine-chart-marker key="a1" label="A1" x="100" y="120" radius="8.5" fill="#19a974" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="a2" label="A2" x="220" y="120" radius="8.5" fill="#19a974" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="a3" label="A3" x="340" y="120" radius="8.5" fill="#19a974" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="central" label="Central" x="420" y="180" radius="8.5" fill="#19a974" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="museum-a" label="Museum" x="480" y="300" radius="8.5" fill="#19a974" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="a6" label="A6" x="620" y="360" radius="8.5" fill="#19a974" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="a7" label="A7" x="780" y="360" radius="8.5" fill="#19a974" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="b1" label="B1" x="80" y="240" radius="8.5" fill="#f2c230" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="b2" label="B2" x="220" y="240" radius="8.5" fill="#f2c230" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="republic" label="Republic" x="520" y="180" radius="8.5" fill="#f2c230" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="b5" label="B5" x="700" y="240" radius="8.5" fill="#f2c230" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="b6" label="B6" x="840" y="240" radius="8.5" fill="#f2c230" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="c1" label="C1" x="140" y="360" radius="8.5" fill="#d9363e" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="c2" label="C2" x="300" y="360" radius="8.5" fill="#d9363e" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="c5" label="C5" x="620" y="120" radius="8.5" fill="#d9363e" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
        <pine-chart-marker key="c6" label="C6" x="760" y="120" radius="8.5" fill="#d9363e" stroke="#ffffff" stroke_width="3"></pine-chart-marker>
      </pine-chart-layer>
      <pine-chart-layer name="reference-foreground">
        <pine-chart-reference-dot key="museum-fg" label="Museum" x="480" y="300" radius="21" fill="#d9363e" stroke="#ffffff" stroke_width="3"></pine-chart-reference-dot>
      </pine-chart-layer>
      <pine-chart-layer name="annotations">
        <pine-chart-icon key="airport-west" kind="plane" x="122" y="82" scale="0.075" fill="#18212f"></pine-chart-icon>
        <pine-chart-icon key="airport-east" kind="plane" x="770" y="82" scale="0.075" fill="#18212f"></pine-chart-icon>
      </pine-chart-layer>
      <pine-chart-layer name="labels">
        <pine-chart-label key="airport-label" text="Airport" x="100" y="120" dx="8" dy="-24" angle="-65" fill="#19a974" text_anchor="start" font_weight="700"></pine-chart-label>
        <pine-chart-label key="central-label" text="Central" x="420" y="180" dx="14" dy="-24" angle="-65" fill="#18212f" text_anchor="start" font_weight="700"></pine-chart-label>
        <pine-chart-label key="museum-label" text="Museum" x="480" y="300" dx="-12" dy="42" angle="-65" fill="#18212f" text_anchor="end" font_weight="700"></pine-chart-label>
        <pine-chart-label key="republic-label" text="Republic" x="520" y="180" dx="12" dy="-24" angle="-65" fill="#18212f" text_anchor="start" font_weight="700"></pine-chart-label>
        <pine-chart-label key="east-gate-label" text="East Gate" x="840" y="240" dx="8" dy="-24" angle="-65" fill="#f2c230" text_anchor="start" font_weight="700"></pine-chart-label>
      </pine-chart-layer>
        </pine-layer-chart>
      </pine-chart-responsive>
    </article>

    <article class="chart-card">
      <header class="chart-card-header">
        <h2>Cohort spread</h2>
        <div class="chart-card-actions" role="group" aria-label="Cohort spread dataset">
          <button type="button"
                  :aria-pressed="scatter_dataset == 'growth' ? 'true' : 'false'"
                  :data-active="scatter_dataset == 'growth'"
                  @click="show_scatter_growth">Growth</button>
          <button type="button"
                  :aria-pressed="scatter_dataset == 'latency' ? 'true' : 'false'"
                  :data-active="scatter_dataset == 'latency'"
                  @click="show_scatter_latency">Latency</button>
        </div>
      </header>
      <pine-chart-responsive class="chart-panel" aspect_ratio="1.55" min_height="220">
        <pine-scatter-chart label="Cohort spread"
                            pp-bind:series="scatter_series"
                            x_label="Size"
                            y_label="Rate"
                            animate="true"
                            animation_duration="180"
                            animation_easing="ease-out"
                            point_radius="4.5"></pine-scatter-chart>
      </pine-chart-responsive>

      <pine-chart-legend class="chart-card-legend"
                         label="Cohort spread legend"
                         interactive="true"
                         @pp:chart:legend-toggle="toggle_scatter_series"
                         pp-bind:items="scatter_legend"></pine-chart-legend>
    </article>

    <article class="chart-card">
      <header class="chart-card-header">
        <h2>Trend area</h2>
        <div class="chart-card-control-stack">
          <div class="chart-card-actions" role="group" aria-label="Trend area dataset">
            <button type="button"
                    :aria-pressed="area_dataset == 'growth' ? 'true' : 'false'"
                    :data-active="area_dataset == 'growth'"
                    @click="show_area_growth">Growth</button>
            <button type="button"
                    :aria-pressed="area_dataset == 'latency' ? 'true' : 'false'"
                    :data-active="area_dataset == 'latency'"
                    @click="show_area_latency">Latency</button>
          </div>
          <div class="chart-card-actions" role="group" aria-label="Trend area layers">
            <button type="button"
                    :aria-pressed="area_forecast_visible ? 'true' : 'false'"
                    :data-active="area_forecast_visible"
                    @click="add_area_forecast">Add forecast</button>
            <button type="button"
                    :aria-disabled="!area_forecast_visible ? 'true' : 'false'"
                    @click="remove_area_forecast">Remove</button>
          </div>
        </div>
      </header>
      <div class="chart-panel chart-panel--custom-tooltip">
        <pine-chart-responsive aspect_ratio="1.55" min_height="220">
          <pine-area-chart label="Trend area"
                           pp-bind:series="area_series"
                           x_label="Week"
                           y_label="Volume"
                           animate="true"
                           animation_duration="180"
                           animation_easing="ease-out"
                           show_markers="true"
                           tooltip="none"
                           @pp:chart:hover="show_custom_tooltip"
                           @pp:chart:hover-end="hide_custom_tooltip"
                           @pp:chart:select="show_selection_detail"
                           @pp:chart:select-end="hide_selection_detail"></pine-area-chart>
        </pine-chart-responsive>

        <div class="chart-custom-tooltip"
             role="status"
             aria-live="polite"
             :data-visible="custom_tooltip_visible"
             :data-tooltip-x="custom_tooltip_x"
             :data-tooltip-y="custom_tooltip_y"
             :style="custom_tooltip_visible ? custom_tooltip_style : ''">
          <span class="chart-custom-tooltip-title"
                pp-text="custom_tooltip_title"></span>
          <strong class="chart-custom-tooltip-value"
                  pp-text="custom_tooltip_value"></strong>
          <span class="chart-custom-tooltip-meta"
                pp-text="custom_tooltip_meta"></span>
        </div>
      </div>

      <div class="chart-selection-detail"
           role="status"
           aria-live="polite"
           :data-visible="selection_visible">
        <span class="chart-selection-detail-title"
              pp-text="selection_title"></span>
        <strong class="chart-selection-detail-value"
                pp-text="selection_value"></strong>
        <span class="chart-selection-detail-meta"
              pp-text="selection_meta"></span>
      </div>

      <pine-chart-legend class="chart-card-legend"
                         label="Trend area legend"
                         interactive="true"
                         @pp:chart:legend-toggle="toggle_area_series"
                         pp-bind:items="area_legend"></pine-chart-legend>
    </article>

    <article class="chart-card">
      <header class="chart-card-header">
        <h2>Distribution</h2>
        <div class="chart-card-control-stack">
          <div class="chart-card-actions" role="group" aria-label="Distribution dataset">
            <button type="button"
                    :aria-pressed="bar_dataset == 'growth' ? 'true' : 'false'"
                    :data-active="bar_dataset == 'growth'"
                    @click="show_bar_growth">Growth</button>
            <button type="button"
                    :aria-pressed="bar_dataset == 'latency' ? 'true' : 'false'"
                    :data-active="bar_dataset == 'latency'"
                    @click="show_bar_latency">Latency</button>
          </div>
          <div class="chart-card-actions" role="group" aria-label="Distribution layout">
            <button type="button"
                    :aria-pressed="bar_mode == 'grouped' ? 'true' : 'false'"
                    :data-active="bar_mode == 'grouped'"
                    @click="show_grouped">Grouped</button>
            <button type="button"
                    :aria-pressed="bar_mode == 'stacked' ? 'true' : 'false'"
                    :data-active="bar_mode == 'stacked'"
                    @click="show_stacked">Stacked</button>
          </div>
        </div>
      </header>
      <pine-chart-responsive class="chart-panel" aspect_ratio="1.55" min_height="220">
        <pine-bar-chart label="Distribution"
                        pp-bind:series="bar_series"
                        pp-bind:mode="bar_mode"
                        x_label="Bucket"
                        animate="true"
                        animation_duration="180"
                        animation_easing="ease-out"
                        y_label="Count"></pine-bar-chart>
      </pine-chart-responsive>

      <pine-chart-legend class="chart-card-legend"
                         label="Distribution legend"
                         interactive="true"
                         @pp:chart:legend-toggle="toggle_bar_series"
                         pp-bind:items="bar_legend"></pine-chart-legend>
    </article>

    <article class="chart-card chart-card--radial">
      <header class="chart-card-header">
        <h2>Channel share</h2>
        <div class="chart-card-control-stack">
          <div class="chart-card-actions" role="group" aria-label="Channel share dataset">
            <button type="button"
                    :aria-pressed="pie_dataset == 'growth' ? 'true' : 'false'"
                    :data-active="pie_dataset == 'growth'"
                    @click="show_pie_growth">Growth</button>
            <button type="button"
                    :aria-pressed="pie_dataset == 'latency' ? 'true' : 'false'"
                    :data-active="pie_dataset == 'latency'"
                    @click="show_pie_latency">Latency</button>
          </div>
          <div class="chart-card-actions" role="group" aria-label="Channel share shape">
            <button type="button"
                    :aria-pressed="pie_shape == 'pie' ? 'true' : 'false'"
                    :data-active="pie_shape == 'pie'"
                    @click="show_pie">Pie</button>
            <button type="button"
                    :aria-pressed="pie_shape == 'donut' ? 'true' : 'false'"
                    :data-active="pie_shape == 'donut'"
                    @click="show_donut">Donut</button>
            <button type="button"
                    :aria-pressed="pie_shape == 'half-donut' ? 'true' : 'false'"
                    :data-active="pie_shape == 'half-donut'"
                    @click="show_half_donut">Half</button>
          </div>
        </div>
      </header>
      <pine-chart-responsive class="chart-panel chart-panel--radial"
                             width="min(280px, 100%)"
                             aspect_ratio="1"
                             min_height="220">
        <pine-pie-chart label="Channel share"
                        pp-bind:data="pie_data"
                        pp-bind:inner_radius="pie_inner_radius"
                        pp-bind:start_angle="pie_start_angle"
                        pp-bind:end_angle="pie_end_angle"
                        pp-bind:center_label="pie_center_label"
                        animate="true"
                        animation_duration="320"
                        animation_easing="cubic-bezier(0.22, 1, 0.36, 1)"
                        pp-bind:center_value="pie_center_value"></pine-pie-chart>
      </pine-chart-responsive>

      <pine-chart-legend class="chart-card-legend"
                         label="Channel share legend"
                         interactive="true"
                         @pp:chart:legend-toggle="toggle_pie_slice"
                         pp-bind:items="pie_legend"></pine-chart-legend>
    </article>

    <article class="chart-card chart-card--radial">
      <header class="chart-card-header">
        <h2>Readiness rings</h2>
        <div class="chart-card-actions" role="group" aria-label="Readiness rings dataset">
          <button type="button"
                  :aria-pressed="radial_dataset == 'growth' ? 'true' : 'false'"
                  :data-active="radial_dataset == 'growth'"
                  @click="show_radial_growth">Growth</button>
          <button type="button"
                  :aria-pressed="radial_dataset == 'latency' ? 'true' : 'false'"
                  :data-active="radial_dataset == 'latency'"
                  @click="show_radial_latency">Latency</button>
        </div>
      </header>
      <pine-chart-responsive class="chart-panel chart-panel--radial"
                             width="min(280px, 100%)"
                             aspect_ratio="1"
                             min_height="220">
        <pine-radial-bar-chart label="Readiness rings"
                               pp-bind:data="radial_data"
                               inner_radius="0.34"
                               ring_gap="7"
                               pp-bind:center_label="radial_center_label"
                               pp-bind:center_value="radial_center_value"
                               animate="true"
                               animation_duration="420"
                               animation_easing="cubic-bezier(0.22, 1, 0.36, 1)"></pine-radial-bar-chart>
      </pine-chart-responsive>

      <pine-chart-legend class="chart-card-legend"
                         label="Readiness rings legend"
                         interactive="true"
                         @pp:chart:legend-toggle="toggle_radial_bar"
                         pp-bind:items="radial_legend"></pine-chart-legend>
    </article>
  </section>
</root>
