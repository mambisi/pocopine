<root
  class="pine-task-item"
  :data-checked="checked"
  :data-error="error"
><button
    class="pine-task-item-check"
    type="button"
    contenteditable="false"
    tabindex="-1"
    aria-label="Toggle task completion"
    :aria-pressed="checked"
    @mousedown.prevent
    pp-on:click="toggle"
  ></button><div
    class="pine-task-item-content"
    pp-owned-content
  ></div></root>
