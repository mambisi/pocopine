<root class="min-h-screen bg-zinc-100 text-zinc-950 antialiased lg:grid lg:grid-cols-[248px_minmax(0,1fr)]">
  <aside class="border-b border-zinc-200 bg-white px-4 py-4 lg:min-h-screen lg:border-b-0 lg:border-r lg:px-5 lg:py-6">
    <div class="flex items-center gap-3 text-sm font-semibold text-zinc-950">
      <span class="inline-flex size-9 items-center justify-center rounded-lg bg-emerald-600 text-white" aria-hidden="true"><pine-icon name="folder" size="21"></pine-icon></span>
      <span>Pocopine Files</span>
    </div>
    <nav class="mt-5 flex gap-2 lg:flex-col" aria-label="Sections">
      <button class="inline-flex h-10 flex-1 items-center gap-2 rounded-md border border-emerald-200 bg-emerald-50 px-3 text-left text-sm font-medium text-emerald-900 lg:flex-none" type="button">
        <pine-icon name="cloud" size="18"></pine-icon>
        <span>Files</span>
      </button>
      <button class="inline-flex h-10 flex-1 items-center gap-2 rounded-md border border-transparent px-3 text-left text-sm font-medium text-zinc-400 disabled:cursor-not-allowed lg:flex-none" type="button" disabled>
        <pine-icon name="database" size="18"></pine-icon>
        <span>Local FS</span>
      </button>
    </nav>
  </aside>

  <main class="min-w-0 px-4 py-5 sm:px-6 lg:px-8">
    <header class="flex flex-wrap items-center justify-between gap-3">
      <div class="min-w-0">
        <h1 class="text-2xl font-semibold tracking-normal text-zinc-950">Files</h1>
        <p class="mt-1 text-sm text-zinc-500"><span pp-text="file_count_label"></span> / <span pp-text="total_size_label"></span></p>
      </div>
      <button class="inline-flex size-10 items-center justify-center rounded-md border border-zinc-300 bg-white text-zinc-700 shadow-sm transition hover:border-zinc-400 hover:text-zinc-950 disabled:cursor-wait disabled:opacity-60" type="button" aria-label="Refresh" @click="refresh" :disabled="loading">
        <pine-icon name="refresh" size="18"></pine-icon>
      </button>
    </header>

    <section class="mt-5">
      <pine-upload scope="files"
                   auto-resume="true"
                   chunk-size="1048576"
                   class="block [&_.pine-upload]:grid [&_.pine-upload]:gap-3 [&_.pine-upload-target]:flex [&_.pine-upload-target]:min-h-32 [&_.pine-upload-target]:cursor-pointer [&_.pine-upload-target]:items-center [&_.pine-upload-target]:justify-center [&_.pine-upload-target]:rounded-lg [&_.pine-upload-target]:border [&_.pine-upload-target]:border-dashed [&_.pine-upload-target]:border-emerald-300 [&_.pine-upload-target]:bg-white [&_.pine-upload-target]:px-5 [&_.pine-upload-target]:py-6 [&_.pine-upload-target]:text-center [&_.pine-upload-target]:shadow-sm [&_.pine-upload-target]:transition [&_.pine-upload-target:hover]:border-emerald-500 [&_.pine-upload-target:hover]:bg-emerald-50/60 [&_.pine-upload-input]:sr-only [&_.pine-upload-progress]:h-2 [&_.pine-upload-progress]:overflow-hidden [&_.pine-upload-progress]:rounded-full [&_.pine-upload-progress]:bg-zinc-200 [&_.pine-upload-progress-bar]:block [&_.pine-upload-progress-bar]:h-full [&_.pine-upload-progress-bar]:rounded-full [&_.pine-upload-progress-bar]:bg-emerald-600 [&_.pine-upload-status]:flex [&_.pine-upload-status]:min-h-7 [&_.pine-upload-status]:flex-wrap [&_.pine-upload-status]:items-center [&_.pine-upload-status]:gap-2 [&_.pine-upload-status]:text-xs [&_.pine-upload-status]:text-zinc-600 [&_.pine-upload-file]:max-w-full [&_.pine-upload-file]:truncate [&_.pine-upload-file]:font-medium [&_.pine-upload-file]:text-zinc-900 [&_.pine-upload-state]:rounded-full [&_.pine-upload-state]:bg-zinc-200 [&_.pine-upload-state]:px-2 [&_.pine-upload-state]:py-0.5 [&_.pine-upload-state]:text-[11px] [&_.pine-upload-state]:font-medium [&_.pine-upload-state]:uppercase [&_.pine-upload-state]:tracking-normal [&_.pine-upload-error]:text-red-700 [&_.pine-upload-cancel]:w-fit [&_.pine-upload-cancel]:rounded-md [&_.pine-upload-cancel]:border [&_.pine-upload-cancel]:border-zinc-300 [&_.pine-upload-cancel]:bg-white [&_.pine-upload-cancel]:px-3 [&_.pine-upload-cancel]:py-1.5 [&_.pine-upload-cancel]:text-sm [&_.pine-upload-cancel]:font-medium [&_.pine-upload-cancel]:text-zinc-700 [&_.pine-upload-cancel]:shadow-sm [&_.pine-upload-cancel:hover]:border-red-300 [&_.pine-upload-cancel:hover]:text-red-700"
                   @pp:upload:complete="upload_complete"
                   @pp:upload:error="upload_failed">
        <span class="flex flex-col items-center gap-2">
          <span class="inline-flex size-11 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700" aria-hidden="true"><pine-icon name="file-upload" size="27"></pine-icon></span>
          <span class="text-sm font-semibold text-zinc-950">Upload file</span>
          <span class="text-xs text-zinc-500">Local filesystem storage</span>
        </span>
      </pine-upload>
    </section>

    <section class="mt-5 overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-200 px-4 py-3">
        <div class="inline-flex h-9 items-center gap-2 rounded-md border border-zinc-200 bg-zinc-50 px-3 text-sm font-medium text-zinc-700">
          <pine-icon name="search" size="17"></pine-icon>
          <span>All files</span>
        </div>
        <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-800" pp-show="loading">Refreshing</span>
      </div>

      <p class="mx-4 mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" pp-show="error" pp-text="error"></p>

      <div pp-show="!files_empty">
        <div class="grid grid-cols-[minmax(0,1fr)_92px] gap-3 border-b border-zinc-200 px-4 py-2 text-xs font-semibold uppercase tracking-normal text-zinc-500 sm:grid-cols-[minmax(0,1fr)_132px_96px_96px]">
          <span>Name</span>
          <span class="hidden sm:block">Modified</span>
          <span class="hidden sm:block">Size</span>
          <span></span>
        </div>
        <template pp-for="file in files" pp-key="file.id">
          <div class="grid grid-cols-[minmax(0,1fr)_92px] items-center gap-3 border-b border-zinc-100 px-4 py-3 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_132px_96px_96px]">
            <div class="flex min-w-0 items-center gap-3">
              <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-md bg-zinc-100 text-zinc-600" aria-hidden="true"><pine-icon :name="file.icon" size="21"></pine-icon></span>
              <div class="min-w-0">
                <a class="block truncate text-sm font-medium text-zinc-950 underline-offset-4 hover:underline" :href="file.download_url" pp-text="file.name"></a>
                <span class="mt-0.5 block text-xs text-zinc-500" pp-show="file.extension" pp-text="file.extension"></span>
              </div>
            </div>
            <span class="hidden text-sm text-zinc-500 sm:block" pp-text="file.modified_label"></span>
            <span class="hidden text-sm text-zinc-500 sm:block" pp-text="file.size_label"></span>
            <div class="flex justify-end gap-1">
              <a class="inline-flex size-9 items-center justify-center rounded-md border border-zinc-200 bg-white text-zinc-600 transition hover:border-zinc-300 hover:text-zinc-950" :href="file.download_url" :aria-label="'Download ' + file.name">
                <pine-icon name="download" size="17"></pine-icon>
              </a>
              <button class="inline-flex size-9 items-center justify-center rounded-md border border-zinc-200 bg-white text-zinc-600 transition hover:border-red-300 hover:text-red-700 disabled:cursor-wait disabled:opacity-60"
                      type="button"
                      :aria-label="'Delete ' + file.name"
                      :disabled="deleting_id == file.id"
                      @click="remove_file(file.id)">
                <pine-icon name="trash" size="17"></pine-icon>
              </button>
            </div>
          </div>
        </template>
      </div>

      <div class="flex min-h-56 flex-col items-center justify-center gap-3 px-4 py-10 text-zinc-500" pp-show="!loading && files_empty">
        <span class="inline-flex size-12 items-center justify-center rounded-lg bg-zinc-100 text-zinc-500"><pine-icon name="upload" size="34"></pine-icon></span>
        <h2 class="text-base font-medium text-zinc-800">No files yet</h2>
      </div>
    </section>
  </main>
</root>
