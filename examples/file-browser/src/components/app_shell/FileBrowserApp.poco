<root class="flex min-h-screen flex-col bg-bg text-ink-100 antialiased">
  <file-browser-top-bar></file-browser-top-bar>

  <div class="flex flex-1 flex-col lg:grid lg:grid-cols-[248px_minmax(0,1fr)]">
    <file-browser-sidebar></file-browser-sidebar>

    <main class="min-w-0 px-4 py-5 sm:px-7 lg:px-9 lg:py-7">
      <nav class="flex items-center gap-1.5 text-[12px] font-medium text-ink-60" aria-label="Breadcrumb">
        <a class="hover:text-ink-100" href="#">Files</a>
        <pine-icon name="chevron-right" size="14"></pine-icon>
        <span class="text-ink-100">All</span>
      </nav>

      <div class="mt-3">
        <file-browser-upload-panel></file-browser-upload-panel>
      </div>

      <div class="mt-6">
        <file-browser-file-list></file-browser-file-list>
      </div>

      <p class="mt-6 text-center font-mono text-[10.5px] uppercase tracking-[0.04em] text-ink-50">
        Resumable uploads · pocopine-storage · TUS 1.0.0
      </p>
    </main>
  </div>
</root>
