<root class="block">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <pine-toggle-group-root type="single"
                            pp-model:value="view"
                            class="flex flex-wrap items-center gap-1.5"
                            aria-label="Filter entries">
      <pine-toggle-group-item value="all"
                              class="inline-flex h-8 cursor-pointer items-center rounded-full border border-line bg-surface px-3 text-[12.5px] font-medium text-ink-70 transition hover:bg-ink-10 data-[state=on]:border-ink-100 data-[state=on]:bg-ink-100 data-[state=on]:text-surface">All</pine-toggle-group-item>
      <pine-toggle-group-item value="folders"
                              class="inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-full border border-line bg-surface px-3 text-[12.5px] font-medium text-ink-70 transition hover:bg-ink-10 data-[state=on]:border-ink-100 data-[state=on]:bg-ink-100 data-[state=on]:text-surface">
        <pine-icon name="folder-open" size="13"></pine-icon><span>Folders</span>
      </pine-toggle-group-item>
      <pine-toggle-group-item value="objects"
                              class="inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-full border border-line bg-surface px-3 text-[12.5px] font-medium text-ink-70 transition hover:bg-ink-10 data-[state=on]:border-ink-100 data-[state=on]:bg-ink-100 data-[state=on]:text-surface">
        <pine-icon name="file" size="13"></pine-icon><span>Objects</span>
      </pine-toggle-group-item>
    </pine-toggle-group-root>

    <div class="flex min-h-8 items-center gap-2 text-[12px] text-ink-50">
      <button class="inline-flex h-8 items-center gap-1.5 rounded-md border border-line bg-surface px-2.5 font-medium text-ink-70 hover:bg-ink-10 hover:text-ink-100 disabled:cursor-not-allowed disabled:opacity-40"
              type="button"
              :disabled="!$store.storage.current_prefix"
              @click="go_up">
        <pine-icon name="arrow-up" size="14"></pine-icon>
        <span>Up</span>
      </button>
      <span pp-show="$store.storage.search_query">
        <span pp-text="$store.storage.visible_entry_count_label"></span> found
      </span>
    </div>
  </div>

  <section class="mt-4 overflow-hidden rounded-[12px] border border-line bg-surface shadow-card">
    <p class="m-4 rounded-md border border-danger-line bg-danger-soft px-3 py-2 text-[13px] text-danger-strong"
       pp-show="$store.storage.error"
       pp-text="$store.storage.error"></p>

    <div pp-show="!$store.storage.visible_entries_empty">
      <div class="grid grid-cols-[minmax(0,1fr)_88px] gap-3 border-b border-line px-5 py-2 font-mono text-[10.5px] font-semibold uppercase tracking-[0.04em] text-ink-50 sm:grid-cols-[minmax(0,1fr)_128px_180px]">
        <span>Name</span>
        <span class="hidden sm:block">Modified</span>
        <span class="text-right sm:text-left">Size</span>
      </div>

      <template pp-for="entry in $store.storage.visible_entries" pp-key="entry.id">
        <div class="grid grid-cols-[minmax(0,1fr)_88px] items-center gap-3 border-b border-line px-5 py-2.5 transition-colors last-of-type:border-b-0 hover:bg-surface-2 data-[active=true]:bg-accent-soft sm:grid-cols-[minmax(0,1fr)_128px_180px]"
             :data-kind="entry.kind"
             :data-active="$store.storage.detail_open && entry.kind == 'object' && entry.key == $store.storage.detail.key">

          <button class="flex min-w-0 cursor-pointer items-center gap-3 text-left"
                  type="button"
                  @click="open_entry(entry.kind, entry.prefix, entry.key)">
            <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-md bg-ink-10 text-ink-70 data-[kind=folder]:bg-accent-soft data-[kind=folder]:text-accent-strong"
                  :data-kind="entry.kind"
                  aria-hidden="true">
              <pine-icon :name="entry.icon" size="19"></pine-icon>
            </span>
            <span class="min-w-0">
              <span class="block truncate text-[14px] font-medium text-ink-100" pp-text="entry.name"></span>
              <span class="mt-0.5 block truncate font-mono text-[10.5px] text-ink-50" pp-text="entry.key || entry.prefix"></span>
            </span>
          </button>

          <span class="hidden text-[13px] text-ink-60 sm:block" pp-text="entry.modified_label"></span>
          <span class="text-right font-mono text-[12px] text-ink-60 sm:text-left" pp-text="entry.size_label"></span>
        </div>
      </template>
    </div>

    <div class="flex flex-col items-center justify-center gap-3 px-5 py-16 text-center text-ink-50"
         pp-show="!$store.storage.loading_entries && $store.storage.visible_entries_empty">
      <span class="inline-flex size-14 items-center justify-center rounded-2xl bg-ink-10 text-ink-60">
        <pine-icon name="bucket" size="26"></pine-icon>
      </span>
      <div>
        <h2 class="text-[15px] font-semibold text-ink-100" pp-show="$store.storage.connections_empty">No storage connection</h2>
        <h2 class="text-[15px] font-semibold text-ink-100" pp-show="!$store.storage.connections_empty && !$store.storage.search_query">No entries in this prefix</h2>
        <h2 class="text-[15px] font-semibold text-ink-100" pp-show="!$store.storage.connections_empty && $store.storage.search_query">No matching entries</h2>
        <p class="mt-1 max-w-xs text-[13px] text-ink-60" pp-text="$store.storage.status"></p>
      </div>
    </div>

    <div class="flex items-center justify-center gap-2 border-t border-line px-5 py-3 text-[12px] text-ink-50"
         pp-show="$store.storage.loading_entries || $store.storage.loading_connections">
      <span class="inline-flex size-4 animate-spin rounded-full border-2 border-ink-20 border-t-accent"
            aria-hidden="true"></span>
      <span>Loading storage…</span>
    </div>
  </section>
</root>
