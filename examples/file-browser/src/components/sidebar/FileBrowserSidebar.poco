<root class="flex shrink-0 flex-col border-b border-line bg-surface px-3 py-4 lg:sticky lg:top-14 lg:h-[calc(100vh-3.5rem)] lg:overflow-y-auto lg:border-b-0 lg:border-r lg:px-4 lg:py-5">
  <nav class="flex gap-1 overflow-x-auto lg:flex-col lg:overflow-visible" aria-label="Workspace">
    <a class="inline-flex h-9 shrink-0 items-center gap-2.5 rounded-md px-3 text-[13px] font-medium text-ink-70 hover:bg-ink-10 hover:text-ink-100 lg:shrink lg:flex-none" href="#">
      <pine-icon name="home" size="17"></pine-icon>
      <span>Home</span>
    </a>
    <a class="inline-flex h-9 shrink-0 items-center gap-2.5 rounded-md bg-ink-10 px-3 text-[13px] font-semibold text-ink-100 lg:shrink lg:flex-none" href="#" aria-current="page">
      <pine-icon name="folder" size="17"></pine-icon>
      <span>All files</span>
    </a>
    <button class="inline-flex h-9 shrink-0 cursor-not-allowed items-center gap-2.5 rounded-md px-3 text-[13px] font-medium text-ink-50 lg:shrink lg:flex-none" type="button" disabled>
      <pine-icon name="clock" size="17"></pine-icon>
      <span>Recents</span>
    </button>
    <button class="inline-flex h-9 shrink-0 cursor-not-allowed items-center gap-2.5 rounded-md px-3 text-[13px] font-medium text-ink-50 lg:shrink lg:flex-none" type="button" disabled>
      <pine-icon name="star" size="17"></pine-icon>
      <span>Starred</span>
    </button>
    <button class="inline-flex h-9 shrink-0 cursor-not-allowed items-center gap-2.5 rounded-md px-3 text-[13px] font-medium text-ink-50 lg:shrink lg:flex-none" type="button" disabled>
      <pine-icon name="share" size="17"></pine-icon>
      <span>Shared</span>
    </button>
    <button class="inline-flex h-9 shrink-0 cursor-not-allowed items-center gap-2.5 rounded-md px-3 text-[13px] font-medium text-ink-50 lg:shrink lg:flex-none" type="button" disabled>
      <pine-icon name="trash" size="17"></pine-icon>
      <span>Deleted</span>
    </button>
  </nav>

  <div class="hidden lg:mt-auto lg:block lg:pt-6">
    <div class="rounded-lg border border-line bg-surface-2 p-3.5">
      <div class="flex items-center gap-2 text-[12px] font-medium uppercase tracking-[0.04em] text-ink-50">
        <pine-icon name="database" size="14"></pine-icon>
        <span>Storage</span>
      </div>
      <div class="mt-2.5 flex items-baseline justify-between text-[13px]">
        <span class="font-medium text-ink-100" pp-text="$store.files.total_size_label"></span>
        <span class="font-mono text-[11px] text-ink-50">of <span pp-text="$store.files.storage_quota_label"></span></span>
      </div>
      <pine-progress-root :value="$store.files.storage_percent" max="100"
                          class="mt-2 block h-1.5 overflow-hidden rounded-full bg-ink-10"
                          aria-label="Storage used">
        <pine-progress-indicator class="block h-full min-w-[2px] rounded-full bg-accent transition-[width] duration-300"></pine-progress-indicator>
      </pine-progress-root>
      <p class="mt-3 text-[11.5px] leading-relaxed text-ink-60">Resumable uploads survive tab refresh and network blips.</p>
    </div>
  </div>
</root>
