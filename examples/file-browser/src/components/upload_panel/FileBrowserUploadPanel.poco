<root class="block">
  <header class="flex flex-wrap items-end justify-between gap-3">
    <div class="min-w-0">
      <div class="mb-1 flex flex-wrap items-center gap-1.5 text-[12px] font-medium text-ink-60">
        <template pp-for="crumb in $store.storage.breadcrumbs" pp-key="crumb.prefix">
          <span class="inline-flex items-center gap-1.5">
            <button class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 hover:bg-ink-10 hover:text-ink-100 data-[current=true]:text-ink-100"
                    type="button"
                    :data-current="crumb.prefix == $store.storage.current_prefix"
                    @click="open_prefix(crumb.prefix)">
              <span pp-text="crumb.label"></span>
            </button>
            <span class="inline-flex" pp-show="crumb.prefix != $store.storage.current_prefix">
              <pine-icon name="chevron-right" size="13"></pine-icon>
            </span>
          </span>
        </template>
      </div>
      <h1 class="text-[24px] font-semibold tracking-tight text-ink-100" pp-text="$store.storage.path_title"></h1>
      <div class="mt-1 flex min-w-0 items-center gap-1.5 text-[13px] text-ink-60">
        <img class="size-4 shrink-0 rounded-sm"
             pp-show="$store.storage.selected_connection_favicon_url"
             :src="$store.storage.selected_connection_favicon_url"
             alt=""
             referrerpolicy="no-referrer" />
        <span class="truncate" pp-text="$store.storage.path_meta"></span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button class="inline-flex h-9 items-center gap-1.5 rounded-md border border-line bg-surface px-3 text-[13px] font-medium text-ink-70 shadow-card transition hover:bg-ink-10 hover:text-ink-100 disabled:cursor-not-allowed disabled:opacity-50"
              type="button"
              :disabled="!$store.storage.selected_connection_id"
              @click="open_new_folder_dialog">
        <pine-icon name="folder-plus" size="15"></pine-icon>
        <span>New Folder</span>
      </button>
      <button class="inline-flex h-9 items-center gap-1.5 rounded-md border border-line bg-surface px-3 text-[13px] font-medium text-ink-70 shadow-card transition hover:bg-ink-10 hover:text-ink-100 disabled:cursor-not-allowed disabled:opacity-50"
              type="button"
              :disabled="!$store.storage.selected_connection_id"
              @click="open_upload_dock">
        <pine-icon name="upload" size="15"></pine-icon>
        <span>Upload</span>
      </button>
      <button class="inline-flex h-9 items-center justify-center rounded-md border border-line bg-surface px-2.5 text-[13px] font-medium text-ink-70 shadow-card transition hover:bg-ink-10 hover:text-ink-100 disabled:cursor-wait disabled:opacity-60"
              type="button"
              aria-label="Refresh"
              @click="refresh"
              :disabled="$store.storage.loading_entries">
        <span pp-show="!$store.storage.loading_entries">
          <pine-icon name="refresh" size="16"></pine-icon>
        </span>
        <span class="inline-flex size-4 animate-spin rounded-full border-2 border-ink-20 border-t-accent"
              pp-show="$store.storage.loading_entries"
              aria-hidden="true"></span>
      </button>
    </div>
  </header>

</root>
