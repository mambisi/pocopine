<root class="sticky top-0 z-20 border-b border-line bg-surface/95 px-4 backdrop-blur-md sm:px-6">
  <div class="relative flex h-14 items-center justify-center">
    <div class="absolute left-0 flex min-w-0 items-center gap-2.5">
      <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-md border border-line bg-surface-2" aria-hidden="true">
        <img class="size-[18px]" src="/icon-mark.svg" alt="" />
      </span>
      <span class="hidden truncate text-[15px] font-semibold tracking-normal text-ink-100 md:inline">Cloud File Explorer</span>
    </div>

    <div class="mx-auto w-full max-w-xl pl-12 pr-12 sm:pr-32 md:px-0">
      <file-browser-storage-command></file-browser-storage-command>
    </div>

    <div class="absolute right-0 flex items-center">
      <button class="inline-flex size-9 items-center justify-center rounded-md border border-line bg-surface text-ink-70 hover:bg-ink-10 hover:text-ink-100"
              type="button"
              :aria-label="dark ? 'Switch to light mode' : 'Switch to dark mode'"
              @click="toggle_theme">
        <pine-icon :name="dark ? 'sun' : 'moon'" size="18"></pine-icon>
      </button>
    </div>
  </div>
</root>
