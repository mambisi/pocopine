<root class="todo">
  <div class="todo-banner" pp-show="stage >= 7">
    <span class="todo-dot"></span> Live at todo.up.railway.app
  </div>

  <form class="todo-add" pp-show="stage == 0 || stage >= 4" pp-on:submit.prevent="add">
    <input
      class="todo-input"
      pp-model="draft"
      type="text"
      placeholder="Add a task…"
      aria-label="New task"
      autocomplete="off"
    />
    <button class="todo-addbtn" type="submit">Add</button>
  </form>

  <ul class="todo-list" pp-on:click="on_list_click">
    <template pp-for="t in items" pp-key="t.id">
      <li class="todo-item" :data-done="t.done ? 'true' : 'false'">
        <button class="todo-check" type="button" data-action="toggle" :data-id="t.id" :aria-pressed="t.done ? 'true' : 'false'">
          <span class="todo-box"></span>
          <span class="todo-text" pp-text="t.text"></span>
        </button>
        <button class="todo-remove" type="button" data-action="remove" :data-id="t.id" aria-label="Remove">×</button>
      </li>
    </template>
  </ul>

  <footer class="todo-foot">
    <span class="todo-foot-left">
      <strong pp-text="left"></strong> left
      <span class="todo-saved" pp-show="stage >= 6">· saved&nbsp;✓</span>
    </span>
    <button class="todo-clear" type="button" pp-on:click="clear_done">Clear done</button>
  </footer>
</root>
