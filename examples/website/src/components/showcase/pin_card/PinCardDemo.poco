<root>
  <h2>OTP — credit card + PIN</h2>
  <section>
    <p style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
      Two OTP fields wired as a tiny card form. Delete and retype any
      slot — the dense-prefix semantics let you rewind and correct a
      digit without losing the whole row.
    </p>

    <label class="pcd-row">
      <span class="pcd-label">Card number</span>
      <pine-otp-field length="16"
                      type="numeric"
                      pp-model:value="card_number"
                      label="Credit card number"></pine-otp-field>
    </label>

    <label class="pcd-row">
      <span class="pcd-label">PIN</span>
      <pine-otp-field length="4"
                      type="numeric"
                      mask="true"
                      pp-model:value="pin"
                      label="PIN"></pine-otp-field>
    </label>

    <div class="pcd-readout">
      <p>Card: <code pp-text="card_number || '(empty)'"></code></p>
      <p>PIN: <code pp-text="pin || '(empty)'"></code></p>
      <p pp-show="complete" style="color:var(--brand-fg, var(--brand))">
        Ready to submit.
      </p>
    </div>
  </section>
</root>
