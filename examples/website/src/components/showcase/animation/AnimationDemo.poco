<root :data-embedded="show_intro ? 'false' : 'true'">
  <h2 pp-show="show_intro">pine-motion — spring feel, stagger, drag</h2>

  <section>
    <p pp-show="show_intro" style="color:var(--fg-muted);font-size:0.875rem;margin:0 0 0.75rem">
      Four demos sharing one library. Springs are sampled into a
      CSS <code>linear()</code> timing function so WAAPI runs them
      on the GPU compositor — no per-frame JavaScript.
    </p>

    <!-- ── spring presets ────────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_springs">
      <h3>Spring presets</h3>
      <p class="pm-hint">
        Click any box to see its spring feel. Presets are the
        canonical react-motion / flip-toolkit names, so
        authors coming from that ecosystem know what to expect.
      </p>
      <div class="pm-spring-row">
        <div class="pm-spring-slot">
          <button class="pm-spring-box gentle" @click="pop_gentle">
            gentle
          </button>
          <span class="pm-spring-caption">120 / 14</span>
        </div>
        <div class="pm-spring-slot">
          <button class="pm-spring-box stiff" @click="pop_stiff">
            stiff
          </button>
          <span class="pm-spring-caption">260 / 26</span>
        </div>
        <div class="pm-spring-slot">
          <button class="pm-spring-box wobbly" @click="pop_wobbly">
            wobbly
          </button>
          <span class="pm-spring-caption">180 / 12</span>
        </div>
        <span class="pm-spring-readout" pp-show="last_spring">
          last fired: <strong pp-text="last_spring"></strong>
        </span>
      </div>
    </div>

    <!-- ── easing presets ────────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_easing">
      <h3>Easing</h3>
      <p class="pm-hint">
        Named cubic-bezier presets. Click one to send the box across
        with that curve — note how <code>Back</code> overshoots and
        <code>Apple</code> decelerates sharply.
      </p>
      <div class="pm-easing-controls">
        <pine-button variant="ghost" @click="easing_quad">Quad</pine-button>
        <pine-button variant="ghost" @click="easing_expo">Expo</pine-button>
        <pine-button variant="ghost" @click="easing_back">Back</pine-button>
        <pine-button variant="ghost" @click="easing_circ">Circ</pine-button>
        <pine-button variant="ghost" @click="easing_apple">Apple</pine-button>
        <span class="pm-hint" style="align-self:center">
          last: <strong pp-text="last_easing || '—'"></strong>
        </span>
      </div>
      <div class="pm-easing-track">
        <div class="pm-easing-box"></div>
      </div>
    </div>

    <!-- ── stagger grid ──────────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_stagger">
      <h3>Stagger</h3>
      <p class="pm-hint">
        Per-index delay with selectable origin. Center emanates
        outward; first is the familiar top-down cascade; last is
        reverse.
      </p>
      <div class="pm-stagger-controls">
        <pine-button variant="ghost" @click="set_origin_first">
          From First
        </pine-button>
        <pine-button variant="ghost" @click="set_origin_center">
          From Center
        </pine-button>
        <pine-button variant="ghost" @click="set_origin_last">
          From Last
        </pine-button>
        <pine-button @click="stagger_play">Play</pine-button>
        <span class="pm-hint" style="align-self:center">
          origin: <strong pp-text="stagger_origin || 'first'"></strong>
        </span>
      </div>
      <div class="pm-stagger-grid">
        <div class="pm-stagger-cell">1</div>
        <div class="pm-stagger-cell">2</div>
        <div class="pm-stagger-cell">3</div>
        <div class="pm-stagger-cell">4</div>
        <div class="pm-stagger-cell">5</div>
        <div class="pm-stagger-cell">6</div>
        <div class="pm-stagger-cell">7</div>
        <div class="pm-stagger-cell">8</div>
        <div class="pm-stagger-cell">9</div>
        <div class="pm-stagger-cell">10</div>
        <div class="pm-stagger-cell">11</div>
        <div class="pm-stagger-cell">12</div>
      </div>
    </div>

    <!-- ── state animation ──────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_state">
      <h3>State animation</h3>
      <p class="pm-hint">
        Motion-style target animation: update transform and depth
        values and the square springs to the new state.
      </p>
      <div class="pm-state-demo">
        <div class="pm-state-stage">
          <div class="pm-state-box"></div>
        </div>
        <div class="pm-state-inputs">
          <label>
            <code>x</code>
            <pine-slider-root min="-260" max="260" step="1" pp-model:value="motion_x">
              <pine-slider-track>
                <pine-slider-range></pine-slider-range>
              </pine-slider-track>
              <pine-slider-thumb></pine-slider-thumb>
            </pine-slider-root>
            <span class="pm-state-value" pp-text="motion_x"></span>
          </label>
          <label>
            <code>y</code>
            <pine-slider-root min="-180" max="180" step="1" pp-model:value="motion_y">
              <pine-slider-track>
                <pine-slider-range></pine-slider-range>
              </pine-slider-track>
              <pine-slider-thumb></pine-slider-thumb>
            </pine-slider-root>
            <span class="pm-state-value" pp-text="motion_y"></span>
          </label>
          <label>
            <code>rotate</code>
            <pine-slider-root min="-360" max="360" step="1" pp-model:value="motion_rotate">
              <pine-slider-track>
                <pine-slider-range></pine-slider-range>
              </pine-slider-track>
              <pine-slider-thumb></pine-slider-thumb>
            </pine-slider-root>
            <span class="pm-state-value" pp-text="motion_rotate"></span>
          </label>
          <label>
            <code>scale</code>
            <pine-slider-root min="0.5" max="1.5" step="0.01" pp-model:value="motion_scale">
              <pine-slider-track>
                <pine-slider-range></pine-slider-range>
              </pine-slider-track>
              <pine-slider-thumb></pine-slider-thumb>
            </pine-slider-root>
            <span class="pm-state-value" pp-text="motion_scale"></span>
          </label>
          <label>
            <code>raise</code>
            <pine-slider-root min="0" max="60" step="1" pp-model:value="motion_raise">
              <pine-slider-track>
                <pine-slider-range></pine-slider-range>
              </pine-slider-track>
              <pine-slider-thumb></pine-slider-thumb>
            </pine-slider-root>
            <span class="pm-state-value" pp-text="motion_raise"></span>
          </label>
          <label>
            <code>shadow</code>
            <pine-slider-root min="0" max="48" step="1" pp-model:value="motion_shadow">
              <pine-slider-track>
                <pine-slider-range></pine-slider-range>
              </pine-slider-track>
              <pine-slider-thumb></pine-slider-thumb>
            </pine-slider-root>
            <span class="pm-state-value" pp-text="motion_shadow"></span>
          </label>
          <div class="pm-state-actions">
            <pine-button variant="ghost" @click="reset_state_motion">Reset</pine-button>
            <pine-button @click="state_pop">Pop</pine-button>
          </div>
        </div>
      </div>
    </div>

    <!-- ── hover ─────────────────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_hover">
      <h3>Hover</h3>
      <p class="pm-hint">
        Pointer-enter springs a lift + deeper shadow; leave springs it
        back. Hover the card.
      </p>
      <div class="pm-hover-card">Hover me</div>
    </div>

    <!-- ── focus ─────────────────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_focus">
      <h3>Focus</h3>
      <p class="pm-hint">
        Focus springs a ring in, blur springs it out — keyboard-friendly
        feedback. Click or tab into the field.
      </p>
      <input class="pm-focus-input" type="text" placeholder="Focus me">
    </div>

    <!-- ── press ─────────────────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_press">
      <h3>Press</h3>
      <p class="pm-hint">
        Pointer-down springs the button down; release bounces it back.
        Press and hold, then release.
      </p>
      <button class="pm-press-btn" type="button">Press me</button>
    </div>

    <!-- ── pan ───────────────────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_pan">
      <h3>Pan</h3>
      <p class="pm-hint">
        Raw pointer tracking before constraints or physics. Drag across
        the zone to read cumulative delta and instantaneous velocity.
      </p>
      <div class="pm-pan-zone">Drag across me</div>
      <div class="pm-pan-readout">
        <code>delta: <strong pp-text="pan_delta || '0, 0'"></strong></code>
        <code>velocity: <strong pp-text="pan_velocity || '0, 0'"></strong></code>
      </div>
    </div>

    <!-- ── 3D tilt ───────────────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_tilt">
      <h3>3D tilt card</h3>
      <p class="pm-hint">
        A Motion-style card container: pointer position rotates the
        card, while child layers lift on hover using
        <code>data-pm-tilt</code>.
      </p>
      <div class="pm-tilt-scene">
        <div class="pm-tilt-card">
          <div class="pm-tilt-glow"></div>
          <span class="pm-tilt-kicker">pine-motion</span>
          <strong class="pm-tilt-title">3D hover depth</strong>
          <p class="pm-tilt-copy">
            Container tilt plus independent child depth layers.
          </p>
          <div class="pm-tilt-chip">translateZ layers</div>
        </div>
      </div>
    </div>

    <!-- ── drag ──────────────────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_drag">
      <h3>Drag with momentum</h3>
      <p class="pm-hint">
        Drag the card inside the dashed area. On release, a gentle
        spring continues the fling velocity to a rest position.
        Clamped to the box so the card stays visible.
      </p>
      <div class="pm-drag-stage">
        <div class="pm-drag-card">drag me</div>
      </div>
    </div>

    <!-- ── scroll progress ───────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_scroll">
      <h3>Scroll progress</h3>
      <p class="pm-hint">
        A bar driven by page-scroll progress (0–1). Scroll the page and
        watch it fill.
      </p>
      <div class="pm-scroll-track">
        <div class="pm-scroll-fill"></div>
      </div>
    </div>

    <!-- ── in-view reveal ────────────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_inview">
      <h3>In-view reveal</h3>
      <p class="pm-hint">
        Fires once when the box scrolls into view — fade + rise. Scroll
        it into view (or reload the page).
      </p>
      <div class="pm-inview-box">I fade in when you reach me</div>
    </div>

    <!-- ── shared layout (FLIP) ──────────────────────────────── -->
    <div class="pm-subsection" pp-show="show_flip">
      <h3>Shared layout (FLIP)</h3>
      <p class="pm-hint">
        Snapshot positions, reorder the DOM, then play the delta. Hit
        Shuffle to move the first tile to the end — every tile springs
        to its new spot.
      </p>
      <div class="pm-flip-controls">
        <pine-button @click="flip_shuffle">Shuffle</pine-button>
      </div>
      <div class="pm-flip-list">
        <div class="pm-flip-item" data-pp-layout-id="f1">1</div>
        <div class="pm-flip-item" data-pp-layout-id="f2">2</div>
        <div class="pm-flip-item" data-pp-layout-id="f3">3</div>
        <div class="pm-flip-item" data-pp-layout-id="f4">4</div>
        <div class="pm-flip-item" data-pp-layout-id="f5">5</div>
      </div>
    </div>
  </section>
</root>
