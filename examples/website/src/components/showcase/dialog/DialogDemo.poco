<root>
  <h2>Dialog</h2>
  <section class="row">
    <pine-dialog-root pp-model:open="open">
      <pine-dialog-trigger pp-as>
        <pine-button variant="destructive">Delete file</pine-button>
      </pine-dialog-trigger>
      <pine-dialog-portal>
        <pine-dialog-overlay></pine-dialog-overlay>
        <pine-dialog-content>
          <pine-dialog-title>Delete file?</pine-dialog-title>
          <pine-dialog-description>This action cannot be undone.</pine-dialog-description>
          <div class="row" style="margin-top:1rem;justify-content:flex-end">
            <pine-dialog-close pp-as>
              <pine-button variant="ghost">Cancel</pine-button>
            </pine-dialog-close>
            <pine-dialog-close pp-as>
              <pine-button variant="destructive">Delete</pine-button>
            </pine-dialog-close>
          </div>
        </pine-dialog-content>
      </pine-dialog-portal>
    </pine-dialog-root>
  </section>

  <!-- PineAlertDialog — interruptive confirmation ────────── -->
</root>
