<root class="hero">
  <img class="hero-mascot" src="/mascot.svg" alt="pocopine mascot">
  <h1><span class="brand">poco</span>pine</h1>
  <p class="tagline">
    A full-stack Rust application framework — reactive Rust/WASM UI,
    type-safe server functions, a local-first data layer, auth,
    storage, and one-command deploy. One language, end to end.
  </p>
  <div class="hero-actions">
    <a class="cta-primary" href="/docs/getting-started/introduction" pp-route>Get started</a>
    <a class="cta-ghost" href="/components" pp-route>Browse components</a>
    <a class="cta-ghost" href="https://github.com/mambisi/pocopine">GitHub ↗</a>
  </div>
</root>
