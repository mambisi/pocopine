<root class="landing">
  <hero></hero>

  <div class="landing-cmd">
    <install-cmd></install-cmd>
  </div>

  <div class="landing-ext">
    <span class="landing-ext-label">Editor extension</span>
    <a class="landing-ext-link" href="https://marketplace.visualstudio.com/items?itemName=pocopine.vscode-poco">Install for VS Code ↗</a>
    <a class="landing-ext-link" href="https://open-vsx.org/extension/pocopine/vscode-poco">Open VSX ↗</a>
  </div>

  <stack-showcase></stack-showcase>
  <stack-flow></stack-flow>
  <!-- RFC-099 — below the fold: keep the SSR markup, defer hydration
       (claim/effects) until it scrolls into view (pp-hydrate="visible"). -->
  <secure-section pp-hydrate="visible"></secure-section>
</root>
