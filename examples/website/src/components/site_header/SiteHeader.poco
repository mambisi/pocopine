<root class="site-header">
  <div class="site-header-bar">
    <a class="site-brand" href="/" pp-route><span class="brand">poco</span>pine</a>

    <nav class="site-nav">
      <a href="/docs/getting-started/introduction" pp-route>Docs</a>
      <pine-hover-card-root open_delay="100" close_delay="220">
        <pine-hover-card-trigger>
          <button type="button" class="site-nav-dd-trigger">Components<pine-icon name="chevron-down" size="14"></pine-icon></button>
        </pine-hover-card-trigger>
        <pine-hover-card-portal>
          <pine-hover-card-content class="nav-popover">
            <button type="button" class="nav-popover-item" @click="go_primitives">UI Primitives</button>
            <button type="button" class="nav-popover-item" @click="go_charts">Charts</button>
            <button type="button" class="nav-popover-item" @click="go_icons">Icons</button>
            <button type="button" class="nav-popover-item" @click="go_motion">Motion &amp; Animation</button>
          </pine-hover-card-content>
        </pine-hover-card-portal>
      </pine-hover-card-root>
    </nav>

    <div class="site-header-actions">
      <button class="site-header-search" @click="open_palette" aria-label="Search (Ctrl+K)">
        <pine-icon name="search" size="14"></pine-icon>
        <span class="site-header-search-label">Search…</span>
        <span class="site-header-search-kbd"><kbd>⌘</kbd><kbd>K</kbd></span>
      </button>

      <a class="site-header-github" href="https://github.com/mambisi/pocopine" aria-label="GitHub repo">
        <pine-icon name="brand-github" size="16"></pine-icon>
      </a>

      <button class="site-header-theme" @click="toggle_theme" aria-label="Toggle theme">
        <pine-icon :name="theme == 'dark' ? 'sun' : 'moon'" size="16"></pine-icon>
      </button>
    </div>
  </div>
</root>
