<article>
  <p pp-show="loading"><em>Loading post #<span pp-text="post_id"></span>&hellip;</em></p>
  <p pp-show="error" style="color:#b22"><span pp-text="error"></span></p>
  <header><h2 pp-text="title"></h2></header>
  <p pp-text="body"></p>
  <button pp-on:click="refresh">refresh</button>
</article>
