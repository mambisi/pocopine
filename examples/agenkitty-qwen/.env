# Agenkitty Qwen example.
#
# This file is committed with placeholder values only. Do not commit real API
# keys. For local testing, copy this file to `.env.local` and pass
# `--env-file examples/agenkitty-qwen/.env.local`.

QWEN_API_KEY=replace-with-your-qwen-api-key
QWEN_BASE_URL=https://your-workspace.your-region.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
