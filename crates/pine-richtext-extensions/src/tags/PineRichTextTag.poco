<root class="pine-richtext-tag" pp-ref="root" role="group" contenteditable="false" :aria-label="accessible_label" :data-tag-id="id" :data-kind="kind" :data-selection="selection_state" :data-editable="editable ? 'true' : 'false'" :data-editor-focused="editor_focused ? 'true' : 'false'"><span class="pine-richtext-tag__prefix" aria-hidden="true">#</span><span class="pine-richtext-tag__label" aria-hidden="true" pp-text="label"></span><button class="pine-richtext-tag__remove" type="button" contenteditable="false" :aria-label="remove_label" :disabled="!editable" @mousedown.prevent pp-on:click="remove"></button></root>
