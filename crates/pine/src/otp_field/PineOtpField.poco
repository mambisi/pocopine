<root class="pine-otp-field"
      role="group"
      pp-ref="root"
      :aria-label="label"
      :data-disabled="disabled">
  <template pp-for="slot in slots" pp-key="slot.index">
    <input class="pine-otp-field-slot"
           type="text"
           maxlength="1"
           autocomplete="one-time-code"
           :data-index="slot.index"
           :inputmode="input_mode"
           :pattern="pattern"
           :aria-label="slot.aria_label"
           :disabled="disabled"
           @input="on_slot_input($event, slot.index)"
           @keydown.backspace="on_slot_backspace($event, slot.index)"
           @keydown.left.prevent="focus_delta(slot.index, -1)"
           @keydown.right.prevent="focus_delta(slot.index, 1)">
  </template>
</root>
