<button type="button"
        class="pine-toggle-group-item"
        tabindex="-1"
        :value="value"
        :aria-pressed="pressed ? 'true' : 'false'"
        :data-state="pressed ? 'on' : 'off'"
        :data-disabled="disabled"
        :disabled="disabled"
        @click="click">
  <slot></slot>
</button>
