<input class="pine-time-field"
       pp-ref="root"
       type="time"
       :name="name"
       :disabled="disabled"
       :readonly="readonly"
       :required="required"
       :step="step > 0 ? step : ''"
       :data-focused="focused"
       :data-touched="touched"
       :data-filled="filled"
       :data-disabled="disabled"
       @focus="on_focus"
       @blur="on_blur"
       @input="on_input"
       @change="on_input">
