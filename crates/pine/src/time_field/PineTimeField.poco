<div class="pine-time-field"
     pp-ref="root"
     role="group"
     :aria-disabled="disabled"
     :aria-readonly="readonly"
     :data-disabled="disabled"
     :data-readonly="readonly"
     :data-focused="focused"
     :data-touched="touched"
     :data-filled="filled"
     :data-invalid="invalid">
  <span class="pine-time-field-segment"
        pp-ref="segment-hour"
        role="spinbutton"
        aria-label="Hour"
        :tabindex="disabled ? -1 : 0"
        data-part="hour"
        :data-active="active_part === 'hour'"
        :data-placeholder="hour_display === 'HH'"
        pp-text="hour_display"
        @focus="focus_hour"
        @blur="on_blur"
        @keydown.prevent.stop="on_key"></span>
  <span class="pine-time-field-separator" aria-hidden="true">:</span>
  <span class="pine-time-field-segment"
        pp-ref="segment-minute"
        role="spinbutton"
        aria-label="Minute"
        :tabindex="disabled ? -1 : 0"
        data-part="minute"
        :data-active="active_part === 'minute'"
        :data-placeholder="minute_display === 'MM'"
        pp-text="minute_display"
        @focus="focus_minute"
        @blur="on_blur"
        @keydown.prevent.stop="on_key"></span>
  <template pp-if="has_seconds">
    <span class="pine-time-field-separator" aria-hidden="true">:</span>
  </template>
  <template pp-if="has_seconds">
    <span class="pine-time-field-segment"
          pp-ref="segment-second"
          role="spinbutton"
          aria-label="Second"
          :tabindex="disabled ? -1 : 0"
          data-part="second"
          :data-active="active_part === 'second'"
          :data-placeholder="second_display === 'SS'"
          pp-text="second_display"
          @focus="focus_second"
          @blur="on_blur"
          @keydown.prevent.stop="on_key"></span>
  </template>
</div>
