<template pp-if="open">
  <!-- The outer <root> is the grid container driven by the
       `collapse` preset: its `grid-template-rows` tweens
       0fr ↔ 1fr so siblings reflow. Any padding / border /
       background declared on `.pine-accordion-content-inner`
       stays inside the clipped grid item, so the outer can
       truly reach 0 height at the end of close — no ghost
       row.

       Authors put padding / borders / background on
       `.pine-accordion-content-inner`, NOT on
       `.pine-accordion-content`. -->
  <root class="pine-accordion-content"
        role="region"
        data-state="open"
        pp-transition="collapse">
    <div class="pine-accordion-content-inner">
      <slot></slot>
    </div>
  </root>
</template>
