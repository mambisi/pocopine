<template pp-if="open">
  <!-- Expects exactly ONE child element from the author. That
       child becomes the grid item the `collapse` preset clips;
       authors put padding / border / background / etc. on their
       own wrapper class, which is where the box-model should
       live so the preset's grid row can truly reach 0 at close.
       The outer grid container stays style-free. -->
  <root class="pine-accordion-content"
        role="region"
        data-state="open"
        pp-transition="collapse">
    <slot></slot>
  </root>
</template>
