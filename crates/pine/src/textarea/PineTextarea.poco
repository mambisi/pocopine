<textarea class="pine-textarea"
          pp-ref="root"
          :name="name"
          :placeholder="placeholder"
          :rows="rows"
          :disabled="disabled"
          :required="required"
          :readonly="readonly"
          :data-disabled="disabled"
          :data-focused="focused"
          :data-touched="touched"
          :data-dirty="dirty"
          :data-filled="filled"
          :data-autosize="autosize"
          @focus="on_focus"
          @blur="on_blur"
          @input="on_input"></textarea>
