<root class="pine-scroll-area-scrollbar"
      pp-ref="rail"
      pp-show="visible"
      :data-orientation="orientation"
      :data-state="visible ? 'visible' : 'hidden'"
      :data-has-overflow="has_overflow"
      :style="orientation == 'horizontal'
                ? 'position: absolute; left: 0; right: 0; bottom: 0; touch-action: none; user-select: none;'
                : 'position: absolute; top: 0; right: 0; bottom: 0; touch-action: none; user-select: none;'">
  <slot></slot>
</root>
