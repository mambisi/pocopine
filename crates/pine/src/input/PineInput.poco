<input class="pine-input"
       pp-ref="root"
       :type="type"
       :name="name"
       :placeholder="placeholder"
       :disabled="disabled"
       :required="required"
       :readonly="readonly"
       :data-disabled="disabled"
       :data-focused="focused"
       :data-touched="touched"
       :data-dirty="dirty"
       :data-filled="filled"
       @focus="on_focus"
       @blur="on_blur"
       @input="on_input">
