<root class="pine-dm-checkbox-item"
      role="menuitemcheckbox"
      tabindex="-1"
      :aria-checked="state == 'indeterminate' ? 'mixed' : (state == 'checked' ? 'true' : 'false')"
      :data-state="state"
      :aria-disabled="disabled"
      :data-disabled="disabled"
      @click="on_select"
      @keydown.enter.prevent="on_select"
      @keydown.space.prevent="on_select">
  <slot></slot>
</root>
