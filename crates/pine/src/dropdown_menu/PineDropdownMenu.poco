<template pp-teleport="body" pp-if="open">
  <ul role="menu"
      class="pine-menu"
      pp-ref="menu"
      data-state="open"
      pp-anchor:bottom-start.offset.4.flip="anchor"
      pp-roving
      @click.outside="close"
      @keydown.escape.prevent="close">
    <slot></slot>
  </ul>
</template>
