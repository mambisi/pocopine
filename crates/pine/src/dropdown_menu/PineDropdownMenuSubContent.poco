<template pp-if="open" pp-teleport="body">
  <!-- `pp-transition` lives on the CLONE root, not the outer
       custom-element tag, because pp-if dispatches enter/leave
       starting from THIS clone. The outer
       pine-dropdown-menu-sub-content lives inside the parent
       dropdown's portal clone, so its macro-stamped preset attrs
       aren't reachable from here. Stamping the shorthand on the
       clone wrapper keeps the slide-down enter + leave firing. -->
  <div class="pine-dm-sub-portal" pp-transition="slide-down">
    <root role="menu"
          class="pine-dm-sub-content"
          pp-ref="menu"
          data-state="open"
          pp-anchor:right-start.offset.2.flip="anchor"
          pp-roving
          @keydown.escape.prevent="close"
          @keydown.arrow-left.prevent="close">
      <slot></slot>
    </root>
  </div>
</template>
