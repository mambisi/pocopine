<root role="menu"
      class="pine-dm-content"
      pp-ref="menu"
      data-state="open"
      pp-roving
      @pointerdown.stop="isolate_interaction"
      @click.stop="isolate_interaction"
      @pointerdown.outside="on_pointer_down_outside"
      @click.outside="on_interact_outside"
      @keydown.escape.prevent="close">
  <slot></slot>
</root>
