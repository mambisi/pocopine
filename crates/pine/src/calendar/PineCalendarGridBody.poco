<div class="pine-calendar-grid-body"
     pp-ref="root"
     role="rowgroup">
  <template pp-for="cell in cells">
    <div class="pine-calendar-cell"
         role="gridcell"
         :data-value="cell.date"
         :data-outside-view="!cell.is_current_month"
         :data-selected="cell.is_selected"
         :data-disabled="cell.is_out_of_bounds || cell.is_disabled">
      <pine-calendar-cell-trigger :date="cell.date" :day="cell.day"></pine-calendar-cell-trigger>
    </div>
  </template>
</div>
