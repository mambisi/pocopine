<root pp-ref="root"
      class="pine-upload-root"
      :data-state="state"
      :data-busy="busy"
      :data-disabled="disabled"
      :data-dragover="dragover"
      :data-has-errors="has_errors"
      :data-files-empty="files_empty">
  <input pp-ref="input"
         class="pine-upload-input"
         type="file"
         hidden
         :accept="accept || false"
         :multiple="multiple"
         :disabled="disabled"
         @change="select_files" />
  <slot :files="files"
        :state="state"
        :busy="busy"
        :disabled="disabled"
        :dragover="dragover"
        :progress="progress"
        :bytes_sent="bytes_sent"
        :bytes_total="bytes_total"
        :file_count="file_count"
        :done_count="done_count"
        :error_count="error_count"
        :queued_count="queued_count"
        :uploading_count="uploading_count"
        :file_count_label="file_count_label"
        :total_size_label="total_size_label"
        :status_label="status_label"
        :files_empty="files_empty"
        :has_errors="has_errors"></slot>
</root>
