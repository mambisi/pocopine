<root pp-ref="root"
      class="pine-upload"
      :data-state="status"
      :data-busy="busy"
      :data-disabled="disabled">
  <label class="pine-upload-target" :data-disabled="disabled || busy">
    <input pp-ref="input"
           class="pine-upload-input"
           type="file"
           :accept="accept || false"
           :disabled="disabled || busy"
           @change="select_file" />
    <span class="pine-upload-slot">
      <slot></slot>
    </span>
  </label>

  <div class="pine-upload-progress"
       role="progressbar"
       aria-valuemin="0"
       aria-valuemax="100"
       :aria-valuenow="busy || progress > 0 ? progress : false"
       pp-show="busy || progress > 0">
    <span class="pine-upload-progress-bar" :style="'width:' + progress + '%'"></span>
  </div>

  <div class="pine-upload-status" pp-show="file_name || error">
    <span class="pine-upload-file" pp-text="file_name"></span>
    <span class="pine-upload-state" pp-text="status"></span>
    <span class="pine-upload-error" pp-show="error" pp-text="error"></span>
  </div>

  <button class="pine-upload-cancel"
          type="button"
          pp-show="busy"
          @click="cancel_upload">
    Cancel
  </button>
</root>
