<root class="pine-splitter-group"
      pp-ref="group"
      :data-direction="direction"
      :style="direction == 'vertical'
                ? 'display: flex; flex-direction: column; width: 100%; height: 100%;'
                : 'display: flex; flex-direction: row; width: 100%; height: 100%;'">
  <slot></slot>
</root>
