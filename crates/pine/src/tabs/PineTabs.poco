<div class="pine-tabs" data-orientation="horizontal">
  <div role="tablist" class="pine-tabs-list"
       pp-roving.horizontal
       @click="on_click">
    <template pp-for="tab in tabs" pp-key="tab.value">
      <button type="button"
              role="tab"
              class="pine-tabs-trigger"
              :id="$id + '-tab-' + tab.value"
              :aria-controls="$id + '-panel-' + tab.value"
              :aria-selected="tab.value == value ? 'true' : 'false'"
              :data-state="tab.value == value ? 'active' : 'inactive'"
              :data-value="tab.value"
              :disabled="tab.disabled"
              pp-text="tab.label">
      </button>
    </template>
  </div>
</div>
