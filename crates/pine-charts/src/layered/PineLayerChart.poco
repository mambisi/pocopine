<root class="pine-chart-root pine-layer-chart"
      role="img"
      :aria-label="label"
      :data-state="state"
      :data-empty="empty"
      :data-invalid="invalid"
      :data-animate="animate"
      :data-animation-duration="animation_duration"
      :data-animation-easing="animation_easing"
      :style="animation_style">
  <div class="pine-layer-chart-definitions"
       hidden
       aria-hidden="true">
    <slot></slot>
  </div>
  <svg class="pine-chart-svg pine-layer-chart-svg"
       :width="width"
       :height="height"
       :viewBox="view_box"
       preserveAspectRatio="none"
       aria-hidden="true"
       focusable="false">
    <g pp-show="ready"
       class="pine-chart-grid pine-layer-chart-guides"
       data-layer="grid"
       aria-hidden="true">
      <template pp-for="guide in svg_guides" pp-key="guide.key">
        <line class="pine-chart-grid-line pine-layer-chart-guide"
              :x1="guide.x1"
              :y1="guide.y1"
              :x2="guide.x2"
              :y2="guide.y2"></line>
      </template>
    </g>
    <g pp-show="ready"
       class="pine-layer-chart-reference-background"
       data-layer="reference-background"
       aria-hidden="true">
      <template pp-for="dot in svg_reference_background_dots" pp-key="dot.key">
        <circle class="pine-layer-chart-reference-dot"
                :cx="dot.x"
                :cy="dot.y"
                :r="dot.radius"
                :fill="dot.fill"
                :stroke="dot.stroke"
                :stroke-width="dot.stroke_width"
                :data-label="dot.label"
                :aria-label="dot.aria_label"></circle>
      </template>
    </g>
    <g pp-show="ready"
       class="pine-layer-chart-lines"
       data-layer="series"
       aria-hidden="true">
      <template pp-for="line in svg_lines" pp-key="line.key">
        <path class="pine-layer-chart-line"
              :d="line.d"
              fill="none"
              pathLength="1"
              :stroke="line.color"
              :stroke-width="line.stroke_width"
              stroke-linecap="round"
              stroke-linejoin="round"
              vector-effect="non-scaling-stroke"
              :data-series="line.label"></path>
      </template>
    </g>
    <g pp-show="ready"
       class="pine-layer-chart-markers"
       data-layer="markers">
      <template pp-for="marker in svg_markers" pp-key="marker.key">
        <circle class="pine-layer-chart-marker"
                :cx="marker.x"
                :cy="marker.y"
                :r="marker.radius"
                :fill="marker.fill"
                :stroke="marker.stroke"
                :stroke-width="marker.stroke_width"
                :data-label="marker.label"
                :aria-label="marker.aria_label"></circle>
      </template>
    </g>
    <g pp-show="ready"
       class="pine-layer-chart-reference-foreground"
       data-layer="reference-foreground">
      <template pp-for="dot in svg_reference_foreground_dots" pp-key="dot.key">
        <circle class="pine-layer-chart-reference-dot"
                :cx="dot.x"
                :cy="dot.y"
                :r="dot.radius"
                :fill="dot.fill"
                :stroke="dot.stroke"
                :stroke-width="dot.stroke_width"
                :data-label="dot.label"
                :aria-label="dot.aria_label"></circle>
      </template>
    </g>
    <g pp-show="ready"
       class="pine-layer-chart-annotations"
       data-layer="annotations"
       aria-hidden="true">
      <template pp-for="icon in svg_icons" pp-key="icon.key">
        <g pp-show="icon.path_d"
           class="pine-layer-chart-icon pine-layer-chart-icon-plane"
           :transform="icon.transform"
           :fill="icon.fill"
           :data-kind="icon.kind">
          <path transform="scale(0.1)"
                fill-rule="evenodd"
                :d="icon.path_d"></path>
        </g>
      </template>
    </g>
    <g pp-show="ready"
       class="pine-layer-chart-labels"
       data-layer="labels">
      <template pp-for="label in svg_labels" pp-key="label.key">
        <text class="pine-layer-chart-label"
              :x="label.x"
              :y="label.y"
              :fill="label.fill"
              :text-anchor="label.text_anchor"
              :font-weight="label.font_weight"
              :transform="label.transform"
              pp-text="label.text"></text>
      </template>
    </g>
  </svg>
  <span pp-show="invalid"
        class="pine-chart-status"
        pp-text="error"></span>
  <span pp-show="empty"
        class="pine-chart-status pine-chart-status-empty"
        role="status"
        pp-text="empty_message"></span>
</root>
