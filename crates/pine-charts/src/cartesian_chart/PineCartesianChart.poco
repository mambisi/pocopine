<root class="pine-chart-root pine-cartesian-chart"
      role="img"
      :aria-label="label"
      :data-state="state"
      :data-empty="empty"
      :data-invalid="invalid">
  <div class="pine-cartesian-chart-definitions"
       hidden
       aria-hidden="true">
    <slot></slot>
  </div>
  <svg class="pine-chart-svg pine-cartesian-chart-svg"
       :width="width"
       :height="height"
       :viewBox="view_box"
       preserveAspectRatio="none"
       aria-hidden="true"
       focusable="false">
    <g pp-show="ready && show_grid"
       class="pine-chart-grid"
       data-layer="grid"
       aria-hidden="true">
      <template pp-for="line in x_grid" pp-key="line.key">
        <line class="pine-chart-grid-line pine-chart-grid-line-x"
              :x1="line.x1"
              :y1="line.y1"
              :x2="line.x2"
              :y2="line.y2"></line>
      </template>
      <template pp-for="line in y_grid" pp-key="line.key">
        <line class="pine-chart-grid-line pine-chart-grid-line-y"
              :x1="line.x1"
              :y1="line.y1"
              :x2="line.x2"
              :y2="line.y2"></line>
      </template>
    </g>
    <g pp-show="ready && (show_x_axis || show_y_axis)"
       class="pine-chart-axes"
       data-layer="axes"
       aria-hidden="true">
      <g pp-show="show_x_axis" class="pine-chart-axis-group pine-chart-axis-group-x">
        <line class="pine-chart-axis pine-chart-axis-x"
              :x1="x_axis.x1"
              :y1="x_axis.y1"
              :x2="x_axis.x2"
              :y2="x_axis.y2"></line>
        <template pp-for="tick in x_tick_labels" pp-key="tick.key">
          <g class="pine-chart-tick pine-chart-tick-x">
            <line class="pine-chart-tick-line"
                  :x1="tick.line_x1"
                  :y1="tick.line_y1"
                  :x2="tick.line_x2"
                  :y2="tick.line_y2"></line>
            <text class="pine-chart-tick-label"
                  :x="tick.x"
                  :y="tick.y"
                  text-anchor="middle"
                  pp-text="tick.label"></text>
          </g>
        </template>
        <text pp-show="x_label"
              class="pine-chart-axis-label pine-chart-axis-label-x"
              :x="x_axis_label.x"
              :y="x_axis_label.y"
              text-anchor="middle"
              pp-text="x_label"></text>
      </g>
      <g pp-show="show_y_axis" class="pine-chart-axis-group pine-chart-axis-group-y">
        <line class="pine-chart-axis pine-chart-axis-y"
              :x1="y_axis.x1"
              :y1="y_axis.y1"
              :x2="y_axis.x2"
              :y2="y_axis.y2"></line>
        <template pp-for="tick in y_tick_labels" pp-key="tick.key">
          <g class="pine-chart-tick pine-chart-tick-y">
            <line class="pine-chart-tick-line"
                  :x1="tick.line_x1"
                  :y1="tick.line_y1"
                  :x2="tick.line_x2"
                  :y2="tick.line_y2"></line>
            <text class="pine-chart-tick-label"
                  :x="tick.x"
                  :y="tick.y"
                  text-anchor="end"
                  pp-text="tick.label"></text>
          </g>
        </template>
        <text pp-show="y_label"
              class="pine-chart-axis-label pine-chart-axis-label-y"
              :x="y_axis_label.x"
              :y="y_axis_label.y"
              :transform="y_axis_label.transform"
              text-anchor="middle"
              pp-text="y_label"></text>
      </g>
    </g>
    <g pp-show="ready && show_reference_background"
       class="pine-chart-reference pine-chart-reference-background"
       data-layer="reference-background">
      <template pp-for="line in reference_background_lines" pp-key="line.key">
        <line class="pine-chart-reference-line"
              :x1="line.x1"
              :y1="line.y1"
              :x2="line.x2"
              :y2="line.y2"
              :stroke="line.color"
              :stroke-width="line.stroke_width"
              :stroke-dasharray="line.stroke_dasharray"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
              :data-label="line.label"
              :aria-label="line.aria_label"></line>
      </template>
      <template pp-for="dot in reference_background_dots" pp-key="dot.key">
        <circle class="pine-chart-reference-dot"
                :cx="dot.x"
                :cy="dot.y"
                :r="dot.radius"
                :fill="dot.fill"
                :stroke="dot.stroke"
                :stroke-width="dot.stroke_width"
                :data-x="dot.data_x"
                :data-y="dot.data_y"
                :data-label="dot.label"
                :aria-label="dot.aria_label"></circle>
      </template>
    </g>
    <g pp-show="ready && show_bars"
       class="pine-chart-bars"
       data-layer="bars">
      <template pp-for="bar in bars" pp-key="bar.key">
        <rect class="pine-chart-bar"
              :x="bar.x"
              :y="bar.y"
              :width="bar.width"
              :height="bar.height"
              :fill="bar.color"
              role="option"
              :aria-label="bar.aria_label"
              :data-key="bar.key"
              :data-category="bar.category_label"
              :data-series="bar.series_label"
              :data-value="bar.value"></rect>
      </template>
    </g>
    <g pp-show="ready && show_areas"
       class="pine-chart-areas"
       data-layer="area"
       aria-hidden="true">
      <template pp-for="series in areas" pp-key="series.key">
        <path class="pine-chart-area"
              :d="series.area_d"
              :fill="series.fill"
              stroke="none"
              :data-series="series.label"></path>
      </template>
      <template pp-for="series in areas" pp-key="series.key">
        <path class="pine-chart-line pine-chart-area-line"
              :d="series.line_d"
              fill="none"
              :stroke="series.color"
              :stroke-width="series.stroke_width"
              stroke-linecap="round"
              stroke-linejoin="round"
              vector-effect="non-scaling-stroke"
              :data-series="series.label"></path>
      </template>
    </g>
    <g pp-show="ready"
       class="pine-chart-lines"
       data-layer="series"
       aria-hidden="true">
      <template pp-for="series in line_series" pp-key="series.key">
        <path class="pine-chart-line"
              :d="series.line_d"
              fill="none"
              :stroke="series.color"
              :stroke-width="series.stroke_width"
              stroke-linecap="round"
              stroke-linejoin="round"
              vector-effect="non-scaling-stroke"
              :data-series="series.label"></path>
      </template>
    </g>
    <g pp-show="ready && show_scatter"
       class="pine-chart-points pine-chart-scatter-points"
       data-layer="points">
      <template pp-for="point in scatter_points" pp-key="point.key">
        <circle class="pine-chart-point pine-chart-scatter-point"
                :cx="point.x"
                :cy="point.y"
                :r="point.radius"
                :fill="point.color"
                role="option"
                :aria-label="point.aria_label"
                :data-key="point.key"
                :data-x="point.data_x"
                :data-y="point.data_y"
                :data-series="point.series_label"></circle>
      </template>
    </g>
    <g pp-show="ready && show_markers"
       class="pine-chart-markers"
       data-layer="markers">
      <template pp-for="marker in markers" pp-key="marker.key">
        <circle class="pine-chart-marker"
                :cx="marker.x"
                :cy="marker.y"
                :r="marker.radius"
                fill="white"
                :stroke="marker.color"
                stroke-width="2"
                :data-x="marker.data_x"
                :data-y="marker.data_y"
                :data-series="marker.series_label"
                :aria-label="marker.aria_label"></circle>
      </template>
    </g>
    <g pp-show="ready && show_reference_foreground"
       class="pine-chart-reference pine-chart-reference-foreground"
       data-layer="reference-foreground">
      <template pp-for="line in reference_foreground_lines" pp-key="line.key">
        <line class="pine-chart-reference-line"
              :x1="line.x1"
              :y1="line.y1"
              :x2="line.x2"
              :y2="line.y2"
              :stroke="line.color"
              :stroke-width="line.stroke_width"
              :stroke-dasharray="line.stroke_dasharray"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
              :data-label="line.label"
              :aria-label="line.aria_label"></line>
      </template>
      <template pp-for="dot in reference_foreground_dots" pp-key="dot.key">
        <circle class="pine-chart-reference-dot"
                :cx="dot.x"
                :cy="dot.y"
                :r="dot.radius"
                :fill="dot.fill"
                :stroke="dot.stroke"
                :stroke-width="dot.stroke_width"
                :data-x="dot.data_x"
                :data-y="dot.data_y"
                :data-label="dot.label"
                :aria-label="dot.aria_label"></circle>
      </template>
    </g>
    <g pp-show="ready && show_reference_labels"
       class="pine-chart-reference-labels"
       data-layer="labels">
      <template pp-for="label in svg_reference_labels" pp-key="label.key">
        <text class="pine-chart-reference-label"
              :x="label.x"
              :y="label.y"
              :fill="label.fill"
              :text-anchor="label.text_anchor"
              :font-weight="label.font_weight"
              :transform="label.transform"
              :data-x="label.data_x"
              :data-y="label.data_y"
              pp-text="label.text"></text>
      </template>
    </g>
  </svg>
  <span pp-show="invalid"
        class="pine-chart-status"
        pp-text="error"></span>
</root>
