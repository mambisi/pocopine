<root class="pine-chart-root pine-bar-chart"
      role="img"
      :aria-label="label"
      :data-state="state"
      :data-empty="empty"
      :data-invalid="invalid"
      :data-hover="hover_visible"
      tabindex="0"
      @keydown.arrow-right.prevent="focus_next_bar"
      @keydown.arrow-down.prevent="focus_next_bar"
      @keydown.arrow-left.prevent="focus_prev_bar"
      @keydown.arrow-up.prevent="focus_prev_bar"
      @keydown.enter.prevent="select_focused_bar"
      @keydown.space.prevent="select_focused_bar">
  <svg class="pine-chart-svg"
       :width="width"
       :height="height"
       :viewBox="view_box"
       preserveAspectRatio="none"
       aria-hidden="true"
       focusable="false"
       @pointermove="on_pointer_move"
       @pointerleave="clear_hover">
    <g pp-show="ready"
       class="pine-chart-grid"
       data-layer="grid"
       aria-hidden="true">
      <template pp-for="line in y_grid" pp-key="line.key">
        <line class="pine-chart-grid-line pine-chart-grid-line-y"
              :x1="line.x1"
              :y1="line.y1"
              :x2="line.x2"
              :y2="line.y2"></line>
      </template>
    </g>
    <g pp-show="ready"
       class="pine-chart-axes"
       data-layer="axes"
       aria-hidden="true">
      <line class="pine-chart-axis pine-chart-axis-x"
            :x1="x_axis.x1"
            :y1="x_axis.y1"
            :x2="x_axis.x2"
            :y2="x_axis.y2"></line>
      <line class="pine-chart-axis pine-chart-axis-y"
            :x1="y_axis.x1"
            :y1="y_axis.y1"
            :x2="y_axis.x2"
            :y2="y_axis.y2"></line>
      <template pp-for="tick in x_tick_labels" pp-key="tick.key">
        <g class="pine-chart-tick pine-chart-tick-x">
          <line class="pine-chart-tick-line"
                :x1="tick.line_x1"
                :y1="tick.line_y1"
                :x2="tick.line_x2"
                :y2="tick.line_y2"></line>
          <text class="pine-chart-tick-label"
                :x="tick.x"
                :y="tick.y"
                text-anchor="middle"
                pp-text="tick.label"></text>
        </g>
      </template>
      <template pp-for="tick in y_tick_labels" pp-key="tick.key">
        <g class="pine-chart-tick pine-chart-tick-y">
          <line class="pine-chart-tick-line"
                :x1="tick.line_x1"
                :y1="tick.line_y1"
                :x2="tick.line_x2"
                :y2="tick.line_y2"></line>
          <text class="pine-chart-tick-label"
                :x="tick.x"
                :y="tick.y"
                text-anchor="end"
                pp-text="tick.label"></text>
        </g>
      </template>
      <text pp-show="x_label"
            class="pine-chart-axis-label pine-chart-axis-label-x"
            :x="x_axis_label.x"
            :y="x_axis_label.y"
            text-anchor="middle"
            pp-text="x_label"></text>
      <text pp-show="y_label"
            class="pine-chart-axis-label pine-chart-axis-label-y"
            :x="y_axis_label.x"
            :y="y_axis_label.y"
            :transform="y_axis_label.transform"
            text-anchor="middle"
            pp-text="y_label"></text>
    </g>
    <g pp-show="ready"
       class="pine-chart-bars"
       data-layer="series">
      <template pp-for="bar in bars" pp-key="bar.key">
        <rect class="pine-chart-bar"
              :x="bar.x"
              :y="bar.y"
              :width="bar.width"
              :height="bar.height"
              role="option"
              :aria-label="bar.aria_label"
              :aria-selected="bar.key == selected_key ? 'true' : 'false'"
              :data-key="bar.key"
              :data-category="bar.category_label"
              :data-series="bar.series_label"
              :data-value="bar.value"
              :data-hovered="bar.key == hover_key"
              :data-focused="bar.key == focused_key"
              :data-selected="bar.key == selected_key"
              @click.stop="select_bar(bar.key)"></rect>
      </template>
    </g>
  </svg>
  <div class="pine-chart-tooltip pine-chart-bar-tooltip"
       :aria-hidden="hover_visible ? 'false' : 'true'"
       role="status"
       :aria-label="hover_aria_label"
       :style="hover_style"
       :data-tooltip-x="hover_placement_x"
       :data-tooltip-y="hover_placement_y"
       :data-category="hover_category"
       :data-value="hover_value"
       :data-series="hover_series">
    <span pp-show="hover_series"
          class="pine-chart-tooltip-series"
          pp-text="hover_series"></span>
    <span class="pine-chart-tooltip-category"
          pp-text="hover_category"></span>
    <span class="pine-chart-tooltip-value"
          pp-text="hover_value_label"></span>
  </div>
  <span pp-show="invalid"
        class="pine-chart-status"
        pp-text="error"></span>
  <span pp-show="empty"
        class="pine-chart-status pine-chart-status-empty"
        role="status"
        pp-text="empty_message"></span>
</root>
