<root class="pine-chart-responsive"
      pp-ref="root"
      :style="container_style"
      :data-ready="ready"
      :data-width="measured_width"
      :data-height="measured_height">
  <div class="pine-chart-responsive-frame"
       pp-ref="frame"
       :style="frame_style">
    <slot></slot>
  </div>
</root>
