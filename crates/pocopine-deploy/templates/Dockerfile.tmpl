FROM rust:1.84-slim-bookworm AS build
WORKDIR /app
{%- if has_rust_toolchain %}
COPY rust-toolchain.toml .
RUN rustup show
{%- endif %}
COPY . .
RUN cargo build --release -p {{ package_name }}{% for proc in process_envs %} --bin {{ proc.bin }}{% endfor %} -p pocopine-launcher --bin pocopine-launcher

FROM gcr.io/distroless/cc-debian12
{%- for proc in process_envs %}
COPY --from=build /app/target/release/{{ proc.bin }} /usr/local/bin/{{ proc.bin }}
{%- endfor %}
COPY --from=build /app/target/release/pocopine-launcher /usr/local/bin/pocopine-launcher
{%- for entry in static_files %}
COPY --from=build {{ project_dir }}/{{ entry }} /var/lib/pocopine/dist/{{ entry }}
{%- endfor %}
ENV POCOPINE_DIST=/var/lib/pocopine/dist
{%- for proc in process_envs %}
ENV {{ proc.env_name }}=/usr/local/bin/{{ proc.bin }}
{%- endfor %}
ENTRYPOINT ["pocopine-launcher"]
